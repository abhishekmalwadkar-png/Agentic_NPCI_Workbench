      <field><name>f_matched_file</name><rename>f_matched_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_unmatched_file</name><rename>f_unmatched_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_result_files</name><rename>f_result_files</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
