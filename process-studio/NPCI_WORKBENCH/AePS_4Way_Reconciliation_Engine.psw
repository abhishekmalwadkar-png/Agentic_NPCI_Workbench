  <step>
    <name>MJSV_Classify_4Way</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;// NPCI RRN layout YDDDHHnnnnnn : Y = last digit of year, DDD = Julian day&#xd;&#xa;function rrnDate(rrn) { var r = txt(rrn); if (!/^\d{12}$/.test(r)) { return null; } var cal = java.util.Calendar.getInstance(); var curYear = cal.get(java.util.Calendar.YEAR); var y = Math.floor(curYear / 10) * 10 + parseInt(r.substring(0, 1), 10); if (y &gt; curYear) { y = y - 10; } var doy = parseInt(r.substring(1, 4), 10); if (doy &lt; 1 || doy &gt; 366) { return null; } var c = java.util.Calendar.getInstance(); c.clear(); c.set(java.util.Calendar.YEAR, y); c.set(java.util.Calendar.DAY_OF_YEAR, doy); return c.getTime(); }&#xd;&#xa;function fmtDate(d) { return (d == null) ? &#x22;&#x22; : String(new java.text.SimpleDateFormat(&#x22;yyyy-MM-dd&#x22;).format(d)); }&#xd;&#xa;function ageDays(d) { if (d == null) { return null; } var t = java.util.Calendar.getInstance(); t.set(java.util.Calendar.HOUR_OF_DAY, 0); t.set(java.util.Calendar.MINUTE, 0); t.set(java.util.Calendar.SECOND, 0); t.set(java.util.Calendar.MILLISECOND, 0); return Math.round((t.getTimeInMillis() - d.getTime()) / 86400000); }&#xd;&#xa;function parseDay(s) { var t = txt(s); if (!/^\d{4}-\d{2}-\d{2}$/.test(t)) { return null; } return new java.text.SimpleDateFormat(&#x22;yyyy-MM-dd&#x22;).parse(t); }&#xd;&#xa;&#xd;&#xa;var mStatus = txt(STATUS).toUpperCase();&#xd;&#xa;var authStatus = txt(AUTH_STATUS).toUpperCase();&#xd;&#xa;var authCode = txt(AUTH_RESP_CODE).toUpperCase();&#xd;&#xa;var termStatus = txt(TERMINAL_STATUS).toUpperCase();&#xd;&#xa;var dispense = txt(DISPENSE_STATUS).toUpperCase();&#xd;&#xa;var glStatus = txt(GL_STATUS).toUpperCase();&#xd;&#xa;var amt = num(AMOUNT);&#xd;&#xa;var glAmt = num(GL_AMOUNT);&#xd;&#xa;var uidaiPresent = (txt(UIDAI_RRN) != &#x22;&#x22;);&#xd;&#xa;var termPresent = (txt(TERM_RRN) != &#x22;&#x22;);&#xd;&#xa;var glPresent = (txt(GL_RRN) != &#x22;&#x22;);&#xd;&#xa;var AMOUNT_VARIANCE = (amt != null &amp;&amp; glAmt != null) ? r2(amt - glAmt) : null;&#xd;&#xa;var absVar = (AMOUNT_VARIANCE == null) ? null : Math.abs(AMOUNT_VARIANCE);&#xd;&#xa;var d = rrnDate(RRN);&#xd;&#xa;var TXN_DATE = fmtDate(d);&#xd;&#xa;var AGE_DAYS = ageDays(d);&#xd;&#xa;var BREAK_CATEGORY = &#x22;&#x22;;&#xd;&#xa;var BREAK_REASON = &#x22;&#x22;;&#xd;&#xa;var EXCEPTION_SEVERITY = &#x22;NONE&#x22;;&#xd;&#xa;if (!uidaiPresent) { BREAK_CATEGORY = &#x22;MISSING_IN_UIDAI&#x22;; BREAK_REASON = &#x22;RRN absent in UIDAI Aadhaar auth gateway feed&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (authCode == &#x22;998&#x22; || authStatus == &#x22;SPOOF&#x22; || authStatus == &#x22;TAMPER&#x22;) { BREAK_CATEGORY = &#x22;BIOMETRIC_SPOOF_ALERT&#x22;; BREAK_REASON = &#x22;UIDAI flagged biometric tamper / spoof - auth code &#x22; + authCode; EXCEPTION_SEVERITY = &#x22;CRITICAL&#x22;; }&#xd;&#xa;else if (authStatus != &#x22;SUCCESS&#x22;) { BREAK_CATEGORY = &#x22;BIOMETRIC_MISMATCH&#x22;; BREAK_REASON = &#x22;UIDAI auth &#x22; + authStatus + &#x22; (code &#x22; + authCode + &#x22;) while NPCI status is &#x22; + mStatus; EXCEPTION_SEVERITY = (mStatus == &#x22;SUCCESS&#x22;) ? &#x22;HIGH&#x22; : &#x22;LOW&#x22;; }&#xd;&#xa;else if (!termPresent) { BREAK_CATEGORY = &#x22;MISSING_IN_TERMINAL&#x22;; BREAK_REASON = &#x22;RRN absent in BC micro-ATM terminal journal&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (termStatus == &#x22;91&#x22;) { BREAK_CATEGORY = &#x22;TERMINAL_TIMEOUT_91&#x22;; BREAK_REASON = &#x22;Micro-ATM issuer/switch timeout (RC 91) - dispense &#x22; + dispense; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (termStatus == &#x22;96&#x22;) { BREAK_CATEGORY = &#x22;TERMINAL_TIMEOUT_96&#x22;; BREAK_REASON = &#x22;Micro-ATM system malfunction (RC 96) - dispense &#x22; + dispense; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (dispense != &#x22;DISPENSED&#x22;) { BREAK_CATEGORY = &#x22;DISPENSE_FAILURE&#x22;; BREAK_REASON = &#x22;Cash not dispensed (&#x22; + dispense + &#x22;) but NPCI status &#x22; + mStatus; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (txt(TERM_BC_ID) != &#x22;&#x22; &amp;&amp; txt(TERM_BC_ID) != txt(BC_ID)) { BREAK_CATEGORY = &#x22;BC_AGENT_MISMATCH&#x22;; BREAK_REASON = &#x22;Terminal BC &#x22; + txt(TERM_BC_ID) + &#x22; differs from NPCI BC &#x22; + txt(BC_ID); EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (!glPresent) { BREAK_CATEGORY = &#x22;MISSING_IN_GL&#x22;; BREAK_REASON = &#x22;No BC agent float entry in GL-9904&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (absVar == null || absVar &gt; 0.001) { BREAK_CATEGORY = &#x22;GL_FLOAT_VARIANCE&#x22;; BREAK_REASON = &#x22;NPCI &#x22; + money(amt) + &#x22; vs GL-9904 &#x22; + money(glAmt) + &#x22; - variance &#x22; + money(AMOUNT_VARIANCE); EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (glStatus != &#x22;POSTED&#x22;) { BREAK_CATEGORY = &#x22;GL_NOT_POSTED&#x22;; BREAK_REASON = &#x22;GL-9904 status &#x22; + glStatus; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (mStatus == &#x22;SUCCESS&#x22; &amp;&amp; authStatus == &#x22;SUCCESS&#x22; &amp;&amp; dispense == &#x22;DISPENSED&#x22; &amp;&amp; glStatus == &#x22;POSTED&#x22;) { BREAK_CATEGORY = &#x22;MATCHED_STP&#x22;; BREAK_REASON = &#x22;4-way match - NPCI, UIDAI, terminal and GL-9904 agree&#x22;; }&#xd;&#xa;else { BREAK_CATEGORY = &#x22;STATUS_MISMATCH&#x22;; BREAK_REASON = &#x22;NPCI &#x22; + mStatus + &#x22; / UIDAI &#x22; + authStatus + &#x22; / dispense &#x22; + dispense + &#x22; / GL &#x22; + glStatus; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;var IS_MATCHED = (BREAK_CATEGORY == &#x22;MATCHED_STP&#x22;) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var MATCH_FLAG = (IS_MATCHED == &#x22;Y&#x22;) ? 1 : 0;&#xd;&#xa;var RECON_RUN_TS = nowTs(&#x22;yyyy-MM-dd HH:mm:ss&#x22;);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>AMOUNT_VARIANCE</name><rename>AMOUNT_VARIANCE</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>TXN_DATE</name><rename>TXN_DATE</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
