<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>AePS_4Way_Reconciliation_Engine</name>
    <description>AePS 4-way reconciliation of NPCI settlement master, UIDAI auth gateway, BC micro-ATM journal and GL-9904 float on RRN.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>INPUT_DIR</name>
        <description>Folder holding the four AePS inbound CSV feeds</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/AEPS_reconn</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for Matched / Unmatched AePS xlsx outputs</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/AEPS_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>CYCLE_ID</name>
        <description>Settlement cycle identifier (informational, stamped in the result)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>AEPS-20261112-CY01</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
    </logging_table>
    <size_rowset>10000</size_rowset>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <key_for_session_key>H4sIAAAAAAAA&#x2f;wMAAAAAAAAAAAA&#x3d;</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop><from>RG_Run_Trigger</from><to>MJSV_Validate_Feeds</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Validate_Feeds</from><to>FR_Feeds_Present</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Feeds_Present</from><to>DUM_Feed_Fanout</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Feeds_Present</from><to>WTL_Missing_Feeds</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_NPCI_Master</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_UIDAI_Auth</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_Terminal_Journal</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_GL9904_Float</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_NPCI_Master</from><to>SR_Sort_Master_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_UIDAI_Auth</from><to>SR_Sort_UIDAI_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_Terminal_Journal</from><to>SR_Sort_Terminal_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_GL9904_Float</from><to>SR_Sort_GL_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Master_RRN</from><to>MJ_Join_UIDAI</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_UIDAI_RRN</from><to>MJ_Join_UIDAI</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJ_Join_UIDAI</from><to>MJ_Join_Terminal</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Terminal_RRN</from><to>MJ_Join_Terminal</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJ_Join_Terminal</from><to>MJ_Join_GL9904</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_GL_RRN</from><to>MJ_Join_GL9904</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJ_Join_GL9904</from><to>MJSV_Classify_4Way</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Classify_4Way</from><to>FR_Is_Matched_STP</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Is_Matched_STP</from><to>XLW_Matched_AePS</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Is_Matched_STP</from><to>XLW_Unmatched_AePS</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_Matched_AePS</from><to>GB_Recon_Summary</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_Unmatched_AePS</from><to>GB_Recon_Summary</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>GB_Recon_Summary</from><to>MJSV_Build_Recon_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Recon_Result</from><to>SWR_Recon_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_NPCI_Master</from><to>WTL_Master_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_UIDAI_Auth</from><to>WTL_UIDAI_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_Terminal_Journal</from><to>WTL_Terminal_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_GL9904_Float</from><to>WTL_GL_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
  </order>

  <step>
    <name>RG_Run_Trigger</name>
    <type>RowGenerator</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field><name>f_trigger</name><type>String</type><format/><currency/><decimal/><group/><nullif>RUN</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>64</xloc>
      <yloc>304</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>MJSV_Validate_Feeds</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var inDir = dirOf(&#x22;INPUT_DIR&#x22;);&#xd;&#xa;var f_master_file = inDir + &#x22;/NPCI_AePS_Settlement_Master.csv&#x22;;&#xd;&#xa;var f_uidai_file = inDir + &#x22;/UIDAI_Aadhaar_Auth_Gateway.csv&#x22;;&#xd;&#xa;var f_terminal_file = inDir + &#x22;/BC_Device_Terminal_Journal.csv&#x22;;&#xd;&#xa;var f_gl_file = inDir + &#x22;/BC_Agent_Float_GL9904.csv&#x22;;&#xd;&#xa;var missing = [];&#xd;&#xa;if (!fileOk(f_master_file)) { missing.push(&#x22;NPCI_AePS_Settlement_Master.csv&#x22;); }&#xd;&#xa;if (!fileOk(f_uidai_file)) { missing.push(&#x22;UIDAI_Aadhaar_Auth_Gateway.csv&#x22;); }&#xd;&#xa;if (!fileOk(f_terminal_file)) { missing.push(&#x22;BC_Device_Terminal_Journal.csv&#x22;); }&#xd;&#xa;if (!fileOk(f_gl_file)) { missing.push(&#x22;BC_Agent_Float_GL9904.csv&#x22;); }&#xd;&#xa;var f_feeds_ok = (missing.length == 0) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var f_missing_feeds = (missing.length == 0) ? &#x22;&#x22; : (&#x22;Missing or empty feed(s) in &#x22; + inDir + &#x22;: &#x22; + missing.join(&#x22;, &#x22;));</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>f_master_file</name><rename>f_master_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_uidai_file</name><rename>f_uidai_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_terminal_file</name><rename>f_terminal_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_gl_file</name><rename>f_gl_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_feeds_ok</name><rename>f_feeds_ok</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_missing_feeds</name><rename>f_missing_feeds</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
