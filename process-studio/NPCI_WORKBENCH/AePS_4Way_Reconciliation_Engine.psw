  <step>
    <name>MJSV_Classify_4Way</name>
    <type>ScriptValueMod</type>
    <description />
    <customErrorMessage />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? "" : String(v).replace(/^\s+|\s+$/g, ""); }
function num(v) { var t = txt(v).replace(/,/g, ""); if (t == "") { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }
function r2(n) { return Math.round(n * 100) / 100; }
function esc(v) { return txt(v).replace(/\\/g, "\\\\").replace(/"/g, "\\\"").replace(/[\r\n\t]+/g, " "); }
function money(v) { var n = num(v); return (n == null) ? "0.00" : n.toFixed(2); }
function jnum(v) { var n = num(v); return (n == null) ? "null" : String(r2(n)); }
function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }
function sha256(s) { var md = java.security.MessageDigest.getInstance("SHA-256"); var d = md.digest(new java.lang.String(s).getBytes("UTF-8")); var h = ""; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = "0" + b; } h = h + b; } return h; }
function pv(name) { var token = "$" + "{Internal.Entry.Current.Directory}"; var base = String(getVariable("Internal.Entry.Current.Directory", "")); return txt(String(getVariable(name, "")).split(token).join(base)); }
function dirOf(name) { return pv(name).replace(/\\/g, "/").replace(/\/+$/, ""); }
function fileOk(p) { if (txt(p) == "") { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }
function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }
function enc(v) { return String(java.net.URLEncoder.encode(txt(v), "UTF-8")); }
function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf("?") &gt;= 0) ? "&amp;" : "?") + q; }
function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }

// NPCI RRN layout YDDDHHnnnnnn : Y = last digit of year, DDD = Julian day
function rrnDate(rrn) { var r = txt(rrn); if (!/^\d{12}$/.test(r)) { return null; } var cal = java.util.Calendar.getInstance(); var curYear = cal.get(java.util.Calendar.YEAR); var y = Math.floor(curYear / 10) * 10 + parseInt(r.substring(0, 1), 10); if (y &gt; curYear) { y = y - 10; } var doy = parseInt(r.substring(1, 4), 10); if (doy &lt; 1 || doy &gt; 366) { return null; } var c = java.util.Calendar.getInstance(); c.clear(); c.set(java.util.Calendar.YEAR, y); c.set(java.util.Calendar.DAY_OF_YEAR, doy); return c.getTime(); }
function fmtDate(d) { return (d == null) ? "" : String(new java.text.SimpleDateFormat("yyyy-MM-dd").format(d)); }
function ageDays(d) { if (d == null) { return null; } var t = java.util.Calendar.getInstance(); t.set(java.util.Calendar.HOUR_OF_DAY, 0); t.set(java.util.Calendar.MINUTE, 0); t.set(java.util.Calendar.SECOND, 0); t.set(java.util.Calendar.MILLISECOND, 0); return Math.round((t.getTimeInMillis() - d.getTime()) / 86400000); }
function parseDay(s) { var t = txt(s); if (!/^\d{4}-\d{2}-\d{2}$/.test(t)) { return null; } return new java.text.SimpleDateFormat("yyyy-MM-dd").parse(t); }

var mStatus = txt(STATUS).toUpperCase();
var authStatus = txt(AUTH_STATUS).toUpperCase();
var authCode = txt(AUTH_RESP_CODE).toUpperCase();
var termStatus = txt(TERMINAL_STATUS).toUpperCase();
var dispense = txt(DISPENSE_STATUS).toUpperCase();
var glStatus = txt(GL_STATUS).toUpperCase();
var amt = num(AMOUNT);
var glAmt = num(GL_AMOUNT);
var uidaiPresent = (txt(UIDAI_RRN) != "");
var termPresent = (txt(TERM_RRN) != "");
var glPresent = (txt(GL_RRN) != "");
var AMOUNT_VARIANCE = (amt != null &amp;&amp; glAmt != null) ? r2(amt - glAmt) : null;
var absVar = (AMOUNT_VARIANCE == null) ? null : Math.abs(AMOUNT_VARIANCE);
var d = rrnDate(RRN);
var TXN_DATE = fmtDate(d);
var AGE_DAYS = ageDays(d);
var BREAK_CATEGORY = "";
var BREAK_REASON = "";
var EXCEPTION_SEVERITY = "NONE";
if (!uidaiPresent) { BREAK_CATEGORY = "MISSING_IN_UIDAI"; BREAK_REASON = "RRN absent in UIDAI Aadhaar auth gateway feed"; EXCEPTION_SEVERITY = "HIGH"; }
else if (authCode == "998" || authStatus == "SPOOF" || authStatus == "TAMPER") { BREAK_CATEGORY = "BIOMETRIC_SPOOF_ALERT"; BREAK_REASON = "UIDAI flagged biometric tamper / spoof - auth code " + authCode; EXCEPTION_SEVERITY = "CRITICAL"; }
else if (authStatus != "SUCCESS") { BREAK_CATEGORY = "BIOMETRIC_MISMATCH"; BREAK_REASON = "UIDAI auth " + authStatus + " (code " + authCode + ") while NPCI status is " + mStatus; EXCEPTION_SEVERITY = (mStatus == "SUCCESS") ? "HIGH" : "LOW"; }
else if (!termPresent) { BREAK_CATEGORY = "MISSING_IN_TERMINAL"; BREAK_REASON = "RRN absent in BC micro-ATM terminal journal"; EXCEPTION_SEVERITY = "HIGH"; }
else if (termStatus == "91") { BREAK_CATEGORY = "TERMINAL_TIMEOUT_91"; BREAK_REASON = "Micro-ATM issuer/switch timeout (RC 91) - dispense " + dispense; EXCEPTION_SEVERITY = "MEDIUM"; }
else if (termStatus == "96") { BREAK_CATEGORY = "TERMINAL_TIMEOUT_96"; BREAK_REASON = "Micro-ATM system malfunction (RC 96) - dispense " + dispense; EXCEPTION_SEVERITY = "MEDIUM"; }
else if (dispense != "DISPENSED") { BREAK_CATEGORY = "DISPENSE_FAILURE"; BREAK_REASON = "Cash not dispensed (" + dispense + ") but NPCI status " + mStatus; EXCEPTION_SEVERITY = "MEDIUM"; }
else if (txt(TERM_BC_ID) != "" &amp;&amp; txt(TERM_BC_ID) != txt(BC_ID)) { BREAK_CATEGORY = "BC_AGENT_MISMATCH"; BREAK_REASON = "Terminal BC " + txt(TERM_BC_ID) + " differs from NPCI BC " + txt(BC_ID); EXCEPTION_SEVERITY = "MEDIUM"; }
else if (!glPresent) { BREAK_CATEGORY = "MISSING_IN_GL"; BREAK_REASON = "No BC agent float entry in GL-9904"; EXCEPTION_SEVERITY = "HIGH"; }
else if (absVar == null || absVar &gt; 0.001) { BREAK_CATEGORY = "GL_FLOAT_VARIANCE"; BREAK_REASON = "NPCI " + money(amt) + " vs GL-9904 " + money(glAmt) + " - variance " + money(AMOUNT_VARIANCE); EXCEPTION_SEVERITY = "HIGH"; }
else if (glStatus != "POSTED") { BREAK_CATEGORY = "GL_NOT_POSTED"; BREAK_REASON = "GL-9904 status " + glStatus; EXCEPTION_SEVERITY = "MEDIUM"; }
else if (mStatus == "SUCCESS" &amp;&amp; authStatus == "SUCCESS" &amp;&amp; dispense == "DISPENSED" &amp;&amp; glStatus == "POSTED") { BREAK_CATEGORY = "MATCHED_STP"; BREAK_REASON = "4-way match - NPCI, UIDAI, terminal and GL-9904 agree"; }
else { BREAK_CATEGORY = "STATUS_MISMATCH"; BREAK_REASON = "NPCI " + mStatus + " / UIDAI " + authStatus + " / dispense " + dispense + " / GL " + glStatus; EXCEPTION_SEVERITY = "MEDIUM"; }
var IS_MATCHED = (BREAK_CATEGORY == "MATCHED_STP") ? "Y" : "N";
var MATCH_FLAG = (IS_MATCHED == "Y") ? 1 : 0;
var RECON_RUN_TS = nowTs("yyyy-MM-dd HH:mm:ss");</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>AMOUNT_VARIANCE</name><rename>AMOUNT_VARIANCE</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>TXN_DATE</name><rename>TXN_DATE</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>AGE_DAYS</name><rename>AGE_DAYS</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>BREAK_CATEGORY</name><rename>BREAK_CATEGORY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>BREAK_REASON</name><rename>BREAK_REASON</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>EXCEPTION_SEVERITY</name><rename>EXCEPTION_SEVERITY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>IS_MATCHED</name><rename>IS_MATCHED</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>MATCH_FLAG</name><rename>MATCH_FLAG</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>RECON_RUN_TS</name><rename>RECON_RUN_TS</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <cluster_schema />
    <remotesteps>
      <input>
