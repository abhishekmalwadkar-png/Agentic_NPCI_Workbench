        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>N</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>NPCI_URL</name>
        <description>CBS reversal queue endpoint for the Auto-Reversal track</description>
