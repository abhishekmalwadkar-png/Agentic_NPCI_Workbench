      <field><name>f_success</name><rename>f_success</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_status</name><rename>f_status</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_message</name><rename>f_message</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
