        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;// NPCI RRN layout YDDDHHnnnnnn : Y = last digit of year, DDD = Julian day&#xd;&#xa;function rrnDate(rrn) { var r = txt(rrn); if (!/^\d{12}$/.test(r)) { return null; } var cal = java.util.Calendar.getInstance(); var curYear = cal.get(java.util.Calendar.YEAR); var y = Math.floor(curYear / 10) * 10 + parseInt(r.substring(0, 1), 10); if (y &gt; curYear) { y = y - 10; } var doy = parseInt(r.substring(1, 4), 10); if (doy &lt; 1 || doy &gt; 366) { return null; } var c = java.util.Calendar.getInstance(); c.clear(); c.set(java.util.Calendar.YEAR, y); c.set(java.util.Calendar.DAY_OF_YEAR, doy); return c.getTime(); }&#xd;&#xa;function fmtDate(d) { return (d == null) ? &#x22;&#x22; : String(new java.text.SimpleDateFormat(&#x22;yyyy-MM-dd&#x22;).format(d)); }&#xd;&#xa;function ageDays(d) { if (d == null) { return null; } var t = java.util.Calendar.getInstance(); t.set(java.util.Calendar.HOUR_OF_DAY, 0); t.set(java.util.Calendar.MINUTE, 0); t.set(java.util.Calendar.SECOND, 0); t.set(java.util.Calendar.MILLISECOND, 0); return Math.round((t.getTimeInMillis() - d.getTime()) / 86400000); }&#xd;&#xa;function parseDay(s) { var t = txt(s); if (!/^\d{4}-\d{2}-\d{2}$/.test(t)) { return null; } return new java.text.SimpleDateFormat(&#x22;yyyy-MM-dd&#x22;).parse(t); }&#xd;&#xa;&#xd;&#xa;var cat = txt(BREAK_CATEGORY);&#xd;&#xa;var amt = num(AMOUNT); if (amt == null) { amt = 0; }&#xd;&#xa;var variance = num(AMOUNT_VARIANCE);&#xd;&#xa;var varAbs = (variance == null) ? 0 : Math.abs(variance);&#xd;&#xa;var exposure = Math.max(amt, varAbs);&#xd;&#xa;var autoLimit = pnum(&#x22;AUTO_REVERSAL_LIMIT&#x22;, 5000);&#xd;&#xa;var hitlLimit = pnum(&#x22;HITL_THRESHOLD&#x22;, 10000);&#xd;&#xa;var tatDays = pnum(&#x22;RBI_TAT_DAYS&#x22;, 1);&#xd;&#xa;var txnDay = parseDay(TXN_DATE); if (txnDay == null) { txnDay = rrnDate(RRN); }&#xd;&#xa;var age = ageDays(txnDay);&#xd;&#xa;var withinTat = (age != null &amp;&amp; age &lt;= tatDays);&#xd;&#xa;var customerDebited = (txt(STATUS).toUpperCase() == &#x22;SUCCESS&#x22;);&#xd;&#xa;var terminalFailure = (cat == &#x22;TERMINAL_TIMEOUT_91&#x22; || cat == &#x22;TERMINAL_TIMEOUT_96&#x22; || cat == &#x22;DISPENSE_FAILURE&#x22;);&#xd;&#xa;var spoof = (cat == &#x22;BIOMETRIC_SPOOF_ALERT&#x22;);&#xd;&#xa;// ---- rule-based AI root-cause engine&#xd;&#xa;var ROOT_CAUSE = &#x22;&#x22;; var RCA_CONFIDENCE = 0.0;&#xd;&#xa;if (cat == &#x22;TERMINAL_TIMEOUT_91&#x22;) { ROOT_CAUSE = &#x22;Issuer/switch response timeout after customer debit - micro-ATM aborted dispense&#x22;; RCA_CONFIDENCE = 0.94; }&#xd;&#xa;else if (cat == &#x22;TERMINAL_TIMEOUT_96&#x22;) { ROOT_CAUSE = &#x22;Terminal system malfunction (RC96) - debit posted, cash cassette not dispensed&#x22;; RCA_CONFIDENCE = 0.91; }&#xd;&#xa;else if (cat == &#x22;DISPENSE_FAILURE&#x22;) { ROOT_CAUSE = &#x22;Hardware dispense fault - journal shows &#x22; + txt(DISPENSE_STATUS); RCA_CONFIDENCE = 0.88; }&#xd;&#xa;else if (spoof) { ROOT_CAUSE = &#x22;UIDAI biometric liveness / tamper alert (auth &#x22; + txt(AUTH_RESP_CODE) + &#x22;) - possible spoofed fingerprint&#x22;; RCA_CONFIDENCE = 0.97; }&#xd;&#xa;else if (cat == &#x22;BIOMETRIC_MISMATCH&#x22;) { ROOT_CAUSE = &#x22;Biometric auth failed (&#x22; + txt(AUTH_RESP_CODE) + &#x22;) but settlement shows &#x22; + txt(STATUS); RCA_CONFIDENCE = 0.82; }&#xd;&#xa;else if (cat == &#x22;GL_FLOAT_VARIANCE&#x22;) { ROOT_CAUSE = &#x22;BC float GL-9904 posting differs by INR &#x22; + varAbs.toFixed(2) + &#x22; - probable manual float entry error&#x22;; RCA_CONFIDENCE = 0.86; }&#xd;&#xa;else if (cat.indexOf(&#x22;MISSING_IN_&#x22;) == 0) { ROOT_CAUSE = &#x22;Leg missing in &#x22; + cat.substring(11) + &#x22; feed - late file or dropped message&#x22;; RCA_CONFIDENCE = 0.75; }&#xd;&#xa;else { ROOT_CAUSE = txt(BREAK_REASON); RCA_CONFIDENCE = 0.60; }&#xd;&#xa;// ---- dual-track routing&#xd;&#xa;var TRACK = &#x22;PARKED_OPS_REVIEW&#x22;; var TRACK_REASON = &#x22;&#x22;; var PRIORITY = &#x22;LOW&#x22;;&#xd;&#xa;if (spoof) { TRACK = &#x22;HITL&#x22;; TRACK_REASON = &#x22;Biometric tamper / spoof alert&#x22;; PRIORITY = &#x22;CRITICAL&#x22;; }&#xd;&#xa;else if (exposure &gt; hitlLimit) { TRACK = &#x22;HITL&#x22;; TRACK_REASON = &#x22;High-value exposure INR &#x22; + exposure.toFixed(2) + &#x22; above &#x22; + hitlLimit.toFixed(0); PRIORITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (terminalFailure &amp;&amp; customerDebited &amp;&amp; amt &lt; autoLimit &amp;&amp; withinTat) { TRACK = &#x22;AUTO_REVERSAL&#x22;; TRACK_REASON = &#x22;Terminal failure under INR &#x22; + autoLimit.toFixed(0) + &#x22; within RBI T+&#x22; + tatDays.toFixed(0) + &#x22; TAT&#x22;; PRIORITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (terminalFailure &amp;&amp; !withinTat) { TRACK_REASON = &#x22;Terminal failure outside RBI T+&#x22; + tatDays.toFixed(0) + &#x22; TAT (age &#x22; + age + &#x22;d) - compensation review&#x22;; PRIORITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else { TRACK_REASON = &#x22;Not eligible for auto-reversal or HITL - operations review&#x22;; }&#xd;&#xa;var IS_HITL = (TRACK == &#x22;HITL&#x22;) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var IS_AUTO = (TRACK == &#x22;AUTO_REVERSAL&#x22;) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var DOSSIER_ID = &#x22;AEPS-&#x22; + ((TRACK == &#x22;HITL&#x22;) ? &#x22;HITL&#x22; : &#x22;REV&#x22;) + &#x22;-&#x22; + txt(RRN);&#xd;&#xa;var canon = [txt(RRN), txt(TXN_ID), txt(AADHAAR_REF), txt(TERMINAL_ID), txt(BC_ID), money(AMOUNT), txt(STATUS), txt(AUTH_STATUS), txt(AUTH_RESP_CODE), txt(TERMINAL_STATUS), txt(DISPENSE_STATUS), money(GL_AMOUNT), txt(GL_STATUS), cat, txt(BREAK_REASON)].join(&#x22;|&#x22;);&#xd;&#xa;var EVIDENCE_HASH = sha256(canon);&#xd;&#xa;var tatDeadline = &#x22;&#x22;;&#xd;&#xa;if (txnDay != null) { var cc = java.util.Calendar.getInstance(); cc.setTime(txnDay); cc.add(java.util.Calendar.DAY_OF_YEAR, tatDays); tatDeadline = String(new java.text.SimpleDateFormat(&#x22;yyyy-MM-dd&#x22;).format(cc.getTime())); }&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var f_idempotency_key = DOSSIER_ID;&#xd;&#xa;var f_request_url = (TRACK == &#x22;HITL&#x22;) ? pv(&#x22;NPCI_QUEUE_URL&#x22;) : pv(&#x22;NPCI_URL&#x22;);&#xd;&#xa;var f_payload = &#x22;&#x22;;&#xd;&#xa;if (TRACK == &#x22;AUTO_REVERSAL&#x22;) {&#xd;&#xa;  f_payload = &#x22;{\&#x22;track\&#x22;:\&#x22;AUTO_REVERSAL\&#x22;,\&#x22;rail\&#x22;:\&#x22;AEPS\&#x22;,\&#x22;queue\&#x22;:\&#x22;CBS_REVERSAL\&#x22;,\&#x22;status\&#x22;:\&#x22;AUTO_APPROVED\&#x22;,\&#x22;instructionId\&#x22;:\&#x22;&#x22; + DOSSIER_ID + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(RRN) + &#x22;\&#x22;,\&#x22;txnId\&#x22;:\&#x22;&#x22; + esc(TXN_ID) + &#x22;\&#x22;,\&#x22;aadhaarRef\&#x22;:\&#x22;&#x22; + esc(AADHAAR_REF) + &#x22;\&#x22;,\&#x22;terminalId\&#x22;:\&#x22;&#x22; + esc(TERMINAL_ID) + &#x22;\&#x22;,\&#x22;bcId\&#x22;:\&#x22;&#x22; + esc(BC_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;amount\&#x22;:&#x22; + amt.toFixed(2) + &#x22;,\&#x22;reasonCode\&#x22;:\&#x22;&#x22; + esc(TERMINAL_STATUS) + &#x22;\&#x22;,\&#x22;breakCategory\&#x22;:\&#x22;&#x22; + esc(cat) + &#x22;\&#x22;,\&#x22;rootCause\&#x22;:\&#x22;&#x22; + esc(ROOT_CAUSE) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;txnDate\&#x22;:\&#x22;&#x22; + esc(TXN_DATE) + &#x22;\&#x22;,\&#x22;rbiTatDeadline\&#x22;:\&#x22;&#x22; + tatDeadline + &#x22;\&#x22;,\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;}&#x22;;&#xd;&#xa;} else if (TRACK == &#x22;HITL&#x22;) {&#xd;&#xa;  f_payload = &#x22;{\&#x22;dossierId\&#x22;:\&#x22;&#x22; + DOSSIER_ID + &#x22;\&#x22;,\&#x22;track\&#x22;:\&#x22;HITL\&#x22;,\&#x22;rail\&#x22;:\&#x22;AEPS\&#x22;,\&#x22;status\&#x22;:\&#x22;PENDING_APPROVAL\&#x22;,\&#x22;priority\&#x22;:\&#x22;&#x22; + PRIORITY + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(RRN) + &#x22;\&#x22;,\&#x22;txnId\&#x22;:\&#x22;&#x22; + esc(TXN_ID) + &#x22;\&#x22;,\&#x22;aadhaarRef\&#x22;:\&#x22;&#x22; + esc(AADHAAR_REF) + &#x22;\&#x22;,\&#x22;terminalId\&#x22;:\&#x22;&#x22; + esc(TERMINAL_ID) + &#x22;\&#x22;,\&#x22;bcId\&#x22;:\&#x22;&#x22; + esc(BC_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;amount\&#x22;:&#x22; + amt.toFixed(2) + &#x22;,\&#x22;exposure\&#x22;:&#x22; + exposure.toFixed(2) + &#x22;,\&#x22;breakCategory\&#x22;:\&#x22;&#x22; + esc(cat) + &#x22;\&#x22;,\&#x22;routingReason\&#x22;:\&#x22;&#x22; + esc(TRACK_REASON) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;rootCause\&#x22;:\&#x22;&#x22; + esc(ROOT_CAUSE) + &#x22;\&#x22;,\&#x22;rcaConfidence\&#x22;:&#x22; + RCA_CONFIDENCE.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;evidence\&#x22;:{\&#x22;npciStatus\&#x22;:\&#x22;&#x22; + esc(STATUS) + &#x22;\&#x22;,\&#x22;authStatus\&#x22;:\&#x22;&#x22; + esc(AUTH_STATUS) + &#x22;\&#x22;,\&#x22;authRespCode\&#x22;:\&#x22;&#x22; + esc(AUTH_RESP_CODE) + &#x22;\&#x22;,\&#x22;terminalStatus\&#x22;:\&#x22;&#x22; + esc(TERMINAL_STATUS) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;dispenseStatus\&#x22;:\&#x22;&#x22; + esc(DISPENSE_STATUS) + &#x22;\&#x22;,\&#x22;glAmount\&#x22;:&#x22; + jnum(GL_AMOUNT) + &#x22;,\&#x22;glStatus\&#x22;:\&#x22;&#x22; + esc(GL_STATUS) + &#x22;\&#x22;,\&#x22;variance\&#x22;:&#x22; + jnum(AMOUNT_VARIANCE) + &#x22;,\&#x22;breakReason\&#x22;:\&#x22;&#x22; + esc(BREAK_REASON) + &#x22;\&#x22;,\&#x22;txnDate\&#x22;:\&#x22;&#x22; + esc(TXN_DATE) + &#x22;\&#x22;},&#x22;&#xd;&#xa;    + &#x22;\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;,\&#x22;createdAt\&#x22;:\&#x22;&#x22; + nowTs(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;) + &#x22;\&#x22;}&#x22;;&#xd;&#xa;}</jsScript_script>
      </jsScript>
    </jsScripts>
