        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/recon/run</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>NPCI_QUEUE_URL</name>
        <description>HITL cockpit queue endpoint for the evidence dossiers</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/queue</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>AUTO_REVERSAL_LIMIT</name>
