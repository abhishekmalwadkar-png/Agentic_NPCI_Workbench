        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>5000</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>HITL_THRESHOLD</name>
        <description>HITL high-value exposure threshold in INR (strictly above)</description>
