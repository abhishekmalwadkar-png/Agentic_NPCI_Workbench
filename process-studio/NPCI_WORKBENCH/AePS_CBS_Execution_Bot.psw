      <field><name>f_result_files</name><rename>f_result_files</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_success</name><rename>f_success</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
