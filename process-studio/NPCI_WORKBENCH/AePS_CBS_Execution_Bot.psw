;{\&#x22;rail\&#x22;:\&#x22;AEPS\&#x22;,\&#x22;core\&#x22;:\&#x22;FINACLE\&#x22;,\&#x22;txnType\&#x22;:\&#x22;CUSTOMER_CREDIT_REVERSAL\&#x22;,\&#x22;reference\&#x22;:\&#x22;&#x22; + esc(REV_REF) + &#x22;\&#x22;,\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(REV_RRN) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;amount\&#x22;:&#x22; + REV_AMOUNT.toFixed(2) + &#x22;,\&#x22;customerRef\&#x22;:\&#x22;&#x22; + esc(REV_ACCOUNT) + &#x22;\&#x22;,\&#x22;bcId\&#x22;:\&#x22;&#x22; + esc(BC_KEY) + &#x22;\&#x22;,\&#x22;track\&#x22;:\&#x22;&#x22; + esc(track) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;narration\&#x22;:\&#x22;AePS failed txn reversal RRN &#x22; + esc(REV_RRN) + &#x22;\&#x22;,\&#x22;requestedAt\&#x22;:\&#x22;&#x22; + nowTs(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;) + &#x22;\&#x22;}&#x22;;</jsScript_script>
