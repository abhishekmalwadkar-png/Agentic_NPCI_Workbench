<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>AePS_CBS_Execution_Bot</name>
    <description>AePS CBS execution bot - polls approved reversals, credits customers on Finacle/CBS and updates BC agent float ledger.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>NPCI_Queue_url</name>
        <description>HITL / reversal queue polled for approved AePS reversals</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/queue</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>CBS_CREDIT_API_URL</name>
        <description>Reversal execution endpoint (backend posts the reversal to Finacle CBS) - called as ?txn_id=&amp;approver=&amp;notes=</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/approve</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>FLOAT_LEDGER_API_URL</name>
        <description>Optional BC agent float ledger (GL-9904) API - blank = compute the float delta and record it in Excel only</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for the execution audit</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/AEPS_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
    </logging_table>
    <size_rowset>10000</size_rowset>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
