  <step>
    <name>MJSV_Build_Execution_Result</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;function latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;&#xd;&#xa;var cr = num(t_credited) || 0; var crf = num(t_credit_failed) || 0; var amt = num(t_amount) || 0;&#xd;&#xa;var fp = num(t_float_posted) || 0; var ff = num(t_float_failed) || 0; var qf = num(t_queue_failed) || 0; var inv = num(t_invalid) || 0;&#xd;&#xa;var f_credited = cr.toFixed(0); var f_credit_failed = crf.toFixed(0); var f_credited_amount = amt.toFixed(2); var f_float_updates = fp.toFixed(0);&#xd;&#xa;var outDir = dirOf(&#x22;OUTPUT_DIR&#x22;);&#xd;&#xa;var rf = [latest(outDir, &#x22;AePS_CBS_Execution_Audit_&#x22;, g_runStart), latest(outDir, &#x22;AePS_Float_Ledger_Events_&#x22;, g_runStart)]; var keep = []; for (var k = 0; k &lt; rf.length; k++) { if (rf[k] != &#x22;&#x22;) { keep.push(rf[k]); } }&#xd;&#xa;var f_result_files = keep.join(&#x22;,&#x22;);&#xd;&#xa;var f_success = &#x22;true&#x22;; var f_status = &#x22;Complete&#x22;; var f_http_code = &#x22;200&#x22;; var f_message = &#x22;&#x22;;&#xd;&#xa;if (inv &gt; 0) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_http_code = &#x22;400&#x22;; f_message = &#x22;AePS CBS bot aborted - invalid configuration: &#x22; + txt(t_detail); }&#xd;&#xa;else if (qf &gt; 0) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_http_code = &#x22;502&#x22;; f_message = &#x22;AePS CBS bot - approved queue fetch failed: &#x22; + txt(t_detail); }&#xd;&#xa;else if (cr + crf == 0) { f_status = &#x22;Diverted&#x22;; f_message = &#x22;AePS CBS bot - no approved AePS reversals pending in queue (HTTP 200)&#x22;; }&#xd;&#xa;else if (crf &gt; 0 || ff &gt; 0) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_http_code = &#x22;207&#x22;; f_message = &#x22;AePS CBS bot - &#x22; + f_credited + &#x22; credited / &#x22; + f_credit_failed + &#x22; CBS failures / &#x22; + ff.toFixed(0) + &#x22; float ledger failures - see audit&#x22;; }&#xd;&#xa;else { f_message = &#x22;AePS CBS Execution Completed - &#x22; + f_credited + &#x22; customer reversals credited (INR &#x22; + f_credited_amount + &#x22;), BC float ledger &#x22; + ((pv(&#x22;FLOAT_LEDGER_API_URL&#x22;) == &#x22;&#x22;) ? &#x22;delta recorded in Excel&#x22; : (&#x22;updated for &#x22; + f_float_updates + &#x22; agents&#x22;)) + &#x22; - HTTP 200&#x22;; }</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>f_credited</name><rename>f_credited</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_credit_failed</name><rename>f_credit_failed</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
