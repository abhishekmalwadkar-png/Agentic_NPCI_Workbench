    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var probs = [];&#xd;&#xa;var inFile = pv(&#x22;Matched_File_Path&#x22;).replace(/\\/g, &#x22;/&#x22;);&#xd;&#xa;if (!fileOk(inFile)) { probs.push(&#x22;Matched_File_Path not found or empty: '&#x22; + inFile + &#x22;'&#x22;); }&#xd;&#xa;if (!urlOk(pv(&#x22;NPCI_URL&#x22;))) { probs.push(&#x22;NPCI_URL is not a valid http(s) URL&#x22;); }&#xd;&#xa;var txnCount = num(f_txn_count); if (txnCount == null) { txnCount = 0; }&#xd;&#xa;var nonStp = num(f_non_stp); if (nonStp == null) { nonStp = 0; }&#xd;&#xa;var setTotal = num(f_settlement_total); if (setTotal == null) { setTotal = 0; }&#xd;&#xa;var glTotal = num(f_gl_total); if (glTotal == null) { glTotal = 0; }&#xd;&#xa;var bcCount = num(f_bc_pools); if (bcCount == null) { bcCount = 0; }&#xd;&#xa;var DELTA = r2(setTotal - glTotal);&#xd;&#xa;var SETTLEMENT_TOTAL = r2(setTotal);&#xd;&#xa;var GL_TOTAL = r2(glTotal);&#xd;&#xa;var TXN_COUNT = txnCount.toFixed(0);&#xd;&#xa;var runId = &#x22;AEPS-KO-&#x22; + nowTs(&#x22;yyyyMMddHHmmss&#x22;);&#xd;&#xa;var POST_READY = &#x22;N&#x22;;&#xd;&#xa;var GATE_STATUS = &#x22;&#x22;;&#xd;&#xa;var GATE_MESSAGE = &#x22;&#x22;;&#xd;&#xa;if (probs.length &gt; 0) { GATE_STATUS = &#x22;Failure&#x22;; GATE_MESSAGE = &#x22;AePS knock-off not posted - &#x22; + probs.join(&#x22;; &#x22;); }&#xd;&#xa;else if (txnCount == 0) { GATE_STATUS = &#x22;Diverted&#x22;; GATE_MESSAGE = &#x22;AePS knock-off not posted - matched file has no STP records&#x22;; }&#xd;&#xa;else if (nonStp &gt; 0) { GATE_STATUS = &#x22;Failure&#x22;; GATE_MESSAGE = &#x22;AePS knock-off not posted - matched file contains &#x22; + nonStp.toFixed(0) + &#x22; non-STP rows&#x22;; }&#xd;&#xa;else if (Math.abs(DELTA) &gt;= 0.005) { GATE_STATUS = &#x22;Failure&#x22;; GATE_MESSAGE = &#x22;AePS knock-off blocked - zero-delta check failed: settlement &#x22; + SETTLEMENT_TOTAL.toFixed(2) + &#x22; vs GL-9904 &#x22; + GL_TOTAL.toFixed(2) + &#x22; (delta &#x22; + DELTA.toFixed(2) + &#x22;)&#x22;; }&#xd;&#xa;else { POST_READY = &#x22;Y&#x22;; GATE_STATUS = &#x22;Ready&#x22;; GATE_MESSAGE = &#x22;Zero-delta verified across &#x22; + TXN_COUNT + &#x22; txns / &#x22; + bcCount.toFixed(0) + &#x22; BC float pools&#x22;; }&#xd;&#xa;var canon = [runId, TXN_COUNT, SETTLEMENT_TOTAL.toFixed(2), GL_TOTAL.toFixed(2), DELTA.toFixed(2), inFile].join(&#x22;|&#x22;);&#xd;&#xa;var EVIDENCE_HASH = sha256(canon);&#xd;&#xa;var f_request_url = pv(&#x22;NPCI_URL&#x22;);&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var f_idempotency_key = runId;&#xd;&#xa;var f_payload = &#x22;{&#x22;&#xd;&#xa;  + &#x22;\&#x22;rail\&#x22;:\&#x22;AEPS\&#x22;,\&#x22;action\&#x22;:\&#x22;GL_ZERO_DELTA_KNOCKOFF\&#x22;,\&#x22;runId\&#x22;:\&#x22;&#x22; + runId + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;glAccount\&#x22;:\&#x22;GL-9904\&#x22;,\&#x22;sourceFile\&#x22;:\&#x22;&#x22; + esc(inFile) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;txnCount\&#x22;:&#x22; + TXN_COUNT + &#x22;,\&#x22;settlementTotal\&#x22;:&#x22; + SETTLEMENT_TOTAL.toFixed(2) + &#x22;,\&#x22;glTotal\&#x22;:&#x22; + GL_TOTAL.toFixed(2) + &#x22;,\&#x22;variance\&#x22;:&#x22; + DELTA.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;entries\&#x22;:[&#x22;&#xd;&#xa;  + &#x22;{\&#x22;leg\&#x22;:\&#x22;DR\&#x22;,\&#x22;account\&#x22;:\&#x22;GL-9904-AEPS-BC-FLOAT-SUSPENSE\&#x22;,\&#x22;amount\&#x22;:&#x22; + SETTLEMENT_TOTAL.toFixed(2) + &#x22;,\&#x22;narration\&#x22;:\&#x22;AePS STP knock-off &#x22; + runId + &#x22;\&#x22;},&#x22;&#xd;&#xa;  + &#x22;{\&#x22;leg\&#x22;:\&#x22;CR\&#x22;,\&#x22;account\&#x22;:\&#x22;NPCI-AEPS-SETTLEMENT-RECEIVABLE\&#x22;,\&#x22;amount\&#x22;:&#x22; + SETTLEMENT_TOTAL.toFixed(2) + &#x22;,\&#x22;narration\&#x22;:\&#x22;AePS STP knock-off &#x22; + runId + &#x22;\&#x22;}],&#x22;&#xd;&#xa;  + &#x22;\&#x22;bcPools\&#x22;:[&#x22; + txt(f_bc_fragments) + &#x22;],&#x22;&#xd;&#xa;  + &#x22;\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;,\&#x22;postedAt\&#x22;:\&#x22;&#x22; + nowTs(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;) + &#x22;\&#x22;}&#x22;;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>DELTA</name><rename>DELTA</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>SETTLEMENT_TOTAL</name><rename>SETTLEMENT_TOTAL</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>GL_TOTAL</name><rename>GL_TOTAL</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
