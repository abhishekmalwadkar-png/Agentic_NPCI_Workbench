<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>AePS_ZeroDelta_GL_KnockOff</name>
    <description>AePS zero-delta knock-off of matched STP settlements against GL-9904 BC float suspense, posted to the CBS/GL API.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>Matched_File_Path</name>
        <description>Full path of Matched_AePS_Records_&lt;TIMESTAMP&gt;.xlsx produced by the recon engine</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>N</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>NPCI_URL</name>
        <description>CBS / GL accounting API that receives the balanced knock-off journal</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/recon/run</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for the knock-off journal audit and rejected rows</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/AEPS_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
