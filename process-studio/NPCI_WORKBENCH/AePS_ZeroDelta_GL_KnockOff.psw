      <field><name>EVIDENCE_HASH</name><rename>EVIDENCE_HASH</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_request_url</name><rename>f_request_url</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_content_type</name><rename>f_content_type</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
