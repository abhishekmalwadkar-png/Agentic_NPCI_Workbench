        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>&#x2f;&#x2f; IMPS 4-way match classification (Rhino ES5)&#xd;&#xa;function txt(v) { return (v == null) ? "" : String(v).replace(/^\s+|\s+$/g, ""); }&#xd;&#xa;function num(v) { var t = txt(v); if (t == "") { return null; } var x = parseFloat(t); return isNaN(x) ? null : x; }&#xd;&#xa;var paramCycle = txt(getVariable("CYCLE_ID", ""));&#xd;&#xa;var swStatus = txt(SWITCH_STATUS).toUpperCase();&#xd;&#xa;var swCode = txt(SWITCH_RESP_CODE);&#xd;&#xa;var cbsStatus = txt(CBS_STATUS).toUpperCase();&#xd;&#xa;var npciAmt = num(NPCI_AMOUNT);&#xd;&#xa;var cbsAmt = num(CBS_AMOUNT);&#xd;&#xa;var switchPresent = (swStatus != "" || swCode != "");&#xd;&#xa;var cbsPresent = (cbsStatus != "" || cbsAmt != null);&#xd;&#xa;var VARIANCE = null;&#xd;&#xa;var absVariance = null;&#xd;&#xa;if (npciAmt != null &amp;&amp; cbsAmt != null) { VARIANCE = Math.round((npciAmt - cbsAmt) * 100) / 100; absVariance = Math.abs(VARIANCE); }&#xd;&#xa;var AMOUNT = (npciAmt != null) ? npciAmt : ((cbsAmt != null) ? cbsAmt : 0);&#xd;&#xa;var switchOk = (swStatus == "AUTHORIZED" || swStatus == "SUCCESS");&#xd;&#xa;var cbsOk = (cbsStatus == "DEBITED" || cbsStatus == "SUCCESS");&#xd;&#xa;var BREAK_CATEGORY = "";&#xd;&#xa;var BREAK_REASON = "";&#xd;&#xa;if (swCode == "91" || swStatus == "TIMEOUT") { BREAK_CATEGORY = "RC91_TIMEOUT"; BREAK_REASON = "Switch timeout - RC " + swCode + " status " + swStatus; }&#xd;&#xa;else if (!switchPresent) { BREAK_CATEGORY = "MISSING_IN_SWITCH"; BREAK_REASON = "RRN not found in Base24 switch feed"; }&#xd;&#xa;else if (!cbsPresent) { BREAK_CATEGORY = "MISSING_IN_CBS"; BREAK_REASON = "RRN not found in Finacle CBS dump"; }&#xd;&#xa;else if (absVariance == null || absVariance &gt; 0.001) { BREAK_CATEGORY = "AMOUNT_MISMATCH"; BREAK_REASON = "NPCI " + npciAmt + " vs CBS " + cbsAmt + " - variance " + VARIANCE; }&#xd;&#xa;else if (cbsStatus == "DEBITED" &amp;&amp; swCode != "00") { BREAK_CATEGORY = "DEEMED_FAILURE"; BREAK_REASON = "CBS debited but switch response code " + swCode; }&#xd;&#xa;else if (paramCycle != "" &amp;&amp; txt(CYCLE_ID) != paramCycle) { BREAK_CATEGORY = "CYCLE_MISMATCH"; BREAK_REASON = "Txn cycle " + txt(CYCLE_ID) + " differs from run cycle " + paramCycle; }&#xd;&#xa;else if (switchOk &amp;&amp; cbsOk &amp;&amp; absVariance == 0) { BREAK_CATEGORY = "MATCHED_STP"; BREAK_REASON = "4-way match - NPCI switch and CBS agree"; }&#xd;&#xa;else { BREAK_CATEGORY = "STATUS_MISMATCH"; BREAK_REASON = "Switch " + swStatus + " / CBS " + cbsStatus; }&#xd;&#xa;var IS_MATCHED = (BREAK_CATEGORY == "MATCHED_STP") ? "Y" : "N";&#xd;&#xa;var MATCH_FLAG = (IS_MATCHED == "Y") ? 1 : 0;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>AMOUNT</name><rename>AMOUNT</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>VARIANCE</name><rename>VARIANCE</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>BREAK_CATEGORY</name><rename>BREAK_CATEGORY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>BREAK_REASON</name><rename>BREAK_REASON</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>IS_MATCHED</name><rename>IS_MATCHED</rename><type>String</type><length>1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>MATCH_FLAG</name><rename>MATCH_FLAG</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
