    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function __txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function __pv(n) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return __txt(String(getVariable(n, &#x22;&#x22;)).split(token).join(base)).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function __fileOk(p) { if (__txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(__txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function __latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;function __files(dir, prefixes) { var out = []; for (var i = 0; i &lt; prefixes.length; i++) { var p = __latest(dir, prefixes[i], g_runStart); if (p != &#x22;&#x22;) { out.push(p); } } return out.join(&#x22;,&#x22;); }&#xd;&#xa;// Build the workflow result and the downloadable file list&#xd;&#xa;function num(v) { if (v == null) { return 0; } var x = parseFloat(String(v)); return isNaN(x) ? 0 : x; }&#xd;&#xa;function resolveDir(d) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return String(d).split(token).join(base); }&#xd;&#xa;var cycle = String(getVariable(&#x22;CYCLE_ID&#x22;, &#x22;&#x22;));&#xd;&#xa;var outDir = resolveDir(getVariable(&#x22;OUTPUT_DIR&#x22;, &#x22;&#x22;));&#xd;&#xa;var totalTxns = num(f_total_rows);&#xd;&#xa;var matchedTxns = num(f_matched_rows);&#xd;&#xa;var breakTxns = totalTxns - matchedTxns;&#xd;&#xa;var f_total_txns = totalTxns.toFixed(0);&#xd;&#xa;var f_matched_txns = matchedTxns.toFixed(0);&#xd;&#xa;var f_break_txns = breakTxns.toFixed(0);&#xd;&#xa;var f_matched_file = __latest(__pv(&#x22;OUTPUT_DIR&#x22;), &#x22;Matched_Records_IMPS_&#x22;, g_runStart);&#xd;&#xa;var f_unmatched_file = __latest(__pv(&#x22;OUTPUT_DIR&#x22;), &#x22;Unmatched_Records_IMPS_&#x22;, g_runStart);&#xd;&#xa;var f_result_files = __files(__pv(&#x22;OUTPUT_DIR&#x22;), [&#x22;Matched_Records_IMPS_&#x22;, &#x22;Unmatched_Records_IMPS_&#x22;]);&#xd;&#xa;var f_success = &#x22;true&#x22;;&#xd;&#xa;var f_status = (totalTxns == 0) ? &#x22;Diverted&#x22; : &#x22;Complete&#x22;;&#xd;&#xa;var f_message = (totalTxns == 0) ? (&#x22;No IMPS transactions found for cycle &#x22; + cycle) : (&#x22;IMPS 4-way recon &#x22; + cycle + &#x22; - &#x22; + f_total_txns + &#x22; txns / &#x22; + f_matched_txns + &#x22; matched STP / &#x22; + f_break_txns + &#x22; breaks&#x22;);</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
