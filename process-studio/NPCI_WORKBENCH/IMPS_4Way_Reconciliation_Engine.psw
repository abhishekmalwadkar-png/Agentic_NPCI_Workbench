<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>IMPS_4Way_Reconciliation_Engine</name>
    <description>IMPS 4-way reconciliation of NPCI clearing, Base24 switch, Finacle CBS and RTGS GL pool on RRN, split into matched STP and categorised breaks.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;09 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;09 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

