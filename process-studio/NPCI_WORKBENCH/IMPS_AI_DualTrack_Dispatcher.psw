<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>IMPS_AI_DualTrack_Dispatcher</name>
    <description>Track B HITL: dispatches high-value and amount-mismatch IMPS breaks as SHA-256 sealed evidence dossiers to the Operations Cockpit maker-checker queue.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;09 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;09 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>INPUT_BREAKS_FILE</name>
        <description>Full path of Unmatched_Records_IMPS_&lt;timestamp&gt;.xlsx (o_unmatched_file of the IMPS recon engine)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>N</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>HITL_THRESHOLD</name>
        <description>Minimum amount in INR requiring Operations Manager sign-off</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>50000</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>HITL_API_ENDPOINT</name>
        <description>Operations Cockpit HITL queue endpoint</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/queue</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for timestamped IMPS Excel outputs (attached to the workflow result)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/IMPS_Recon/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
    </logging_table>
    <size_rowset>10000</size_rowset>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <key_for_session_key>H4sIAAAAAAAA&#x2f;wMAAAAAAAAAAAA&#x3d;</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop><from>XLS_Read_Breaks_File</from><to>GPSV_Get_HITL_Threshold</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>GPSV_Get_HITL_Threshold</from><to>FR_HITL_Eligible</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_HITL_Eligible</from><to>MJSV_Build_Evidence_Dossier</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_HITL_Eligible</from><to>DUM_Handled_By_Track_A</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Evidence_Dossier</from><to>REST_Dispatch_HITL_Queue</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_Dispatch_HITL_Queue</from><to>MJSV_Tag_Dispatch_Outcome</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Tag_Dispatch_Outcome</from><to>XLW_HITL_Dispatch_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
