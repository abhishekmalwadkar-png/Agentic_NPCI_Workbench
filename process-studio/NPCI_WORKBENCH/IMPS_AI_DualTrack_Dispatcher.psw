  <step>
    <name>MJSV_Build_Dispatch_Result</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function __txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function __pv(n) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return __txt(String(getVariable(n, &#x22;&#x22;)).split(token).join(base)).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function __fileOk(p) { if (__txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(__txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function __latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;function __files(dir, prefixes) { var out = []; for (var i = 0; i &lt; prefixes.length; i++) { var p = __latest(dir, prefixes[i], g_runStart); if (p != &#x22;&#x22;) { out.push(p); } } return out.join(&#x22;,&#x22;); }&#xd;&#xa;// Build the workflow result and the downloadable file list&#xd;&#xa;function num(v) { if (v == null) { return 0; } var x = parseFloat(String(v)); return isNaN(x) ? 0 : x; }&#xd;&#xa;var baseDir = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;));&#xd;&#xa;var totalRows = num(f_total_rows);&#xd;&#xa;var dispatchedRows = num(f_dispatched_rows);&#xd;&#xa;var rejectedRows = totalRows - dispatchedRows;&#xd;&#xa;var f_dispatched_count = dispatchedRows.toFixed(0);&#xd;&#xa;var f_rejected_count = rejectedRows.toFixed(0);&#xd;&#xa;var f_dispatched_value = num(f_dispatched_amount).toFixed(2);&#xd;&#xa;var f_result_files = __files(__pv(&#x22;OUTPUT_DIR&#x22;), [&#x22;HITL_Dispatch_Audit_IMPS_&#x22;, &#x22;HITL_API_Errors_IMPS_&#x22;]);&#xd;&#xa;var f_success = &#x22;true&#x22;;&#xd;&#xa;var f_status = &#x22;Complete&#x22;;&#xd;&#xa;var f_message = &#x22;&#x22;;&#xd;&#xa;if (totalRows == 0) { f_status = &#x22;Diverted&#x22;; f_message = &#x22;No high-value or amount-mismatch IMPS breaks require HITL sign-off&#x22;; }&#xd;&#xa;else if (rejectedRows &gt; 0) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_message = &#x22;HITL dispatch - &#x22; + f_dispatched_count + &#x22; dossiers queued / &#x22; + f_rejected_count + &#x22; rejected by the cockpit - see the HITL_Dispatch_Audit_IMPS xlsx&#x22;; }&#xd;&#xa;else { f_message = &#x22;HITL dispatch - &#x22; + f_dispatched_count + &#x22; SHA-256 sealed dossiers queued for Operations Manager sign-off totalling INR &#x22; + f_dispatched_value; }&#xd;&#xa;if (!__fileOk(__pv(&#x22;INPUT_BREAKS_FILE&#x22;))) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_message = &#x22;IMPS Unmatched_Records file not found or empty: '&#x22; + __pv(&#x22;INPUT_BREAKS_FILE&#x22;) + &#x22;' - pass the Unmatched_Records_IMPS_&lt;timestamp&gt;.xlsx path&#x22;; }</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
