    <hop><from>GB_Dispatch_Summary</from><to>MJSV_Build_Dispatch_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Dispatch_Result</from><to>SWR_Dispatch_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_Dispatch_HITL_Queue</from><to>WTL_HITL_API_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>WTL_HITL_API_Error</from><to>XLW_HITL_API_Error_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_HITL_API_Error_Audit</from><to>SWR_API_Failure</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>RG_Run_Trigger</from><to>MJSV_Validate_Input_File</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Validate_Input_File</from><to>FR_Input_File_Valid</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Input_File_Valid</from><to>DUM_Valid_Input_File</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Input_File_Valid</from><to>WTL_Input_File_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Valid_Input_File</from><to>XLS_Read_Breaks_File</to><enabled>Y</enabled><visible>Y</visible></hop>
  </order>

  <step>
