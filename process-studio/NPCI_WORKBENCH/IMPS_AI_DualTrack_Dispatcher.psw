      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field><name>RRN</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>TXN_ID</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>UTR</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>REMITTER_BANK</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>BENEFICIARY_BANK</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>CYCLE_ID</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>TXN_DATETIME</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>NPCI_AMOUNT</name><type>Number</type><length>15</length><precision>2</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>NPCI_STATUS</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>SWITCH_STATUS</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>SWITCH_RESP_CODE</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>NETWORK_LATENCY_MS</name><type>Integer</type><length>15</length><precision>0</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>CBS_AMOUNT</name><type>Number</type><length>15</length><precision>2</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>CBS_STATUS</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>REMITTER_ACC</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>BENEFICIARY_ACC</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>GL_AMOUNT</name><type>Number</type><length>15</length><precision>2</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>GL_STATUS</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>NET_CYCLE_ID</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>RBI_VOUCHER_NO</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>AMOUNT</name><type>Number</type><length>15</length><precision>2</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>VARIANCE</name><type>Number</type><length>15</length><precision>2</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>BREAK_CATEGORY</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>BREAK_REASON</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
      <field><name>IS_MATCHED</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat><format/><currency/><decimal/><group/></field>
    </fields>
    <sheets>
    </sheets>
    <strict_types>N</strict_types>
