    </GUI>
  </step>

  <step>
    <name>MJSV_Build_Evidence_Dossier</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function __txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function __pv(n) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return __txt(String(getVariable(n, &#x22;&#x22;)).split(token).join(base)).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function __fileOk(p) { if (__txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(__txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function __latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;function __files(dir, prefixes) { var out = []; for (var i = 0; i &lt; prefixes.length; i++) { var p = __latest(dir, prefixes[i], g_runStart); if (p != &#x22;&#x22;) { out.push(p); } } return out.join(&#x22;,&#x22;); }&#xd;&#xa;// Build a SHA-256 sealed evidence dossier for the HITL cockpit (Rhino ES5)&#xd;&#xa;function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v); if (t == &#x22;&#x22;) { return null; } var x = parseFloat(t); return isNaN(x) ? null : x; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;); }&#xd;&#xa;function money(v) { var x = num(v); return (x == null) ? &#x22;null&#x22; : x.toFixed(2); }&#xd;&#xa;var threshold = num(f_hitl_threshold);&#xd;&#xa;if (threshold == null) { threshold = 50000; }&#xd;&#xa;var amt = num(AMOUNT);&#xd;&#xa;if (amt == null) { amt = 0; }&#xd;&#xa;var highValue = (amt &gt;= threshold);&#xd;&#xa;var mismatch = (txt(BREAK_CATEGORY) == &#x22;AMOUNT_MISMATCH&#x22;);&#xd;&#xa;var ROUTING_REASON = (highValue &amp;&amp; mismatch) ? &#x22;HIGH_VALUE_AND_AMOUNT_MISMATCH&#x22; : (highValue ? &#x22;HIGH_VALUE_ABOVE_HITL_THRESHOLD&#x22; : &#x22;AMOUNT_MISMATCH&#x22;);&#xd;&#xa;var HITL_PRIORITY = highValue ? &#x22;HIGH&#x22; : &#x22;MEDIUM&#x22;;&#xd;&#xa;var DOSSIER_ID = &#x22;HITL-&#x22; + txt(CYCLE_ID) + &#x22;-&#x22; + txt(RRN);&#xd;&#xa;var canon = [txt(RRN), txt(TXN_ID), txt(UTR), txt(CYCLE_ID), money(NPCI_AMOUNT), money(CBS_AMOUNT), money(GL_AMOUNT), txt(SWITCH_STATUS), txt(SWITCH_RESP_CODE), txt(CBS_STATUS), txt(GL_STATUS), txt(BREAK_CATEGORY), txt(BREAK_REASON)].join(&#x22;|&#x22;);&#xd;&#xa;var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;);&#xd;&#xa;var digest = md.digest(new java.lang.String(canon).getBytes(&#x22;UTF-8&#x22;));&#xd;&#xa;var hex = &#x22;&#x22;;&#xd;&#xa;for (var i = 0; i &lt; digest.length; i++) { var h = (digest[i] &amp; 0xff).toString(16); if (h.length &lt; 2) { h = &#x22;0&#x22; + h; } hex = hex + h; }&#xd;&#xa;var EVIDENCE_HASH = hex;&#xd;&#xa;var f_request_url = txt(getVariable(&#x22;HITL_API_ENDPOINT&#x22;, &#x22;&#x22;));&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var baseDir = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;));&#xd;&#xa;var f_result_files = __files(__pv(&#x22;OUTPUT_DIR&#x22;), [&#x22;HITL_Dispatch_Audit_IMPS_&#x22;, &#x22;HITL_API_Errors_IMPS_&#x22;]);&#xd;&#xa;var f_dossier_payload = &#x22;{&#x22;&#xd;&#xa;  + &#x22;\&#x22;dossierId\&#x22;:\&#x22;&#x22; + esc(DOSSIER_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;track\&#x22;:\&#x22;B_HITL\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;rail\&#x22;:\&#x22;IMPS\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(RRN) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;txnId\&#x22;:\&#x22;&#x22; + esc(TXN_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;utr\&#x22;:\&#x22;&#x22; + esc(UTR) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;cycleId\&#x22;:\&#x22;&#x22; + esc(CYCLE_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;remitterBank\&#x22;:\&#x22;&#x22; + esc(REMITTER_BANK) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;beneficiaryBank\&#x22;:\&#x22;&#x22; + esc(BENEFICIARY_BANK) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;amount\&#x22;:&#x22; + amt.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;npciAmount\&#x22;:&#x22; + money(NPCI_AMOUNT) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;cbsAmount\&#x22;:&#x22; + money(CBS_AMOUNT) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;glAmount\&#x22;:&#x22; + money(GL_AMOUNT) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;variance\&#x22;:&#x22; + money(VARIANCE) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;switchStatus\&#x22;:\&#x22;&#x22; + esc(SWITCH_STATUS) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;switchRespCode\&#x22;:\&#x22;&#x22; + esc(SWITCH_RESP_CODE) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;cbsStatus\&#x22;:\&#x22;&#x22; + esc(CBS_STATUS) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;breakCategory\&#x22;:\&#x22;&#x22; + esc(BREAK_CATEGORY) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;breakReason\&#x22;:\&#x22;&#x22; + esc(BREAK_REASON) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;priority\&#x22;:\&#x22;&#x22; + HITL_PRIORITY + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;routingReason\&#x22;:\&#x22;&#x22; + ROUTING_REASON + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;hitlThreshold\&#x22;:&#x22; + threshold.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;hashAlgorithm\&#x22;:\&#x22;SHA-256\&#x22;&#x22;&#xd;&#xa;  + &#x22;}&#x22;;</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
