  <step>
    <name>FR_HITL_Eligible</name>
    <type>FilterRows</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>MJSV_Build_Evidence_Dossier</send_true_to>
    <send_false_to>DUM_Handled_By_Track_A</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>AMOUNT</leftvalue>
            <function>&gt;&#x3d;</function>
            <rightvalue>f_hitl_threshold</rightvalue>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>OR</operator>
            <leftvalue>BREAK_CATEGORY</leftvalue>
            <function>&#x3d;</function>
            <rightvalue/>
            <value><name>constant</name><type>String</type><text>AMOUNT_MISMATCH</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>928</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
