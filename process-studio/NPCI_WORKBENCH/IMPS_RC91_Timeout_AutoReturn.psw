  <step>
    <name>MJSV_Validate_Input_File</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function __txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function __pv(n) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return __txt(String(getVariable(n, &#x22;&#x22;)).split(token).join(base)).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function __fileOk(p) { if (__txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(__txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function __latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;function __files(dir, prefixes) { var out = []; for (var i = 0; i &lt; prefixes.length; i++) { var p = __latest(dir, prefixes[i], g_runStart); if (p != &#x22;&#x22;) { out.push(p); } } return out.join(&#x22;,&#x22;); }&#xd;&#xa;&#xd;&#xa;var f_input_file = __pv(&#x22;INPUT_BREAKS_FILE&#x22;);&#xd;&#xa;var probs = [];&#xd;&#xa;if (!__fileOk(f_input_file)) { probs.push(&#x22;INPUT_BREAKS_FILE not found or empty: '&#x22; + f_input_file + &#x22;' - pass the Unmatched_Records_IMPS_&lt;timestamp&gt;.xlsx path&#x22;); }&#xd;&#xa;else if (!/\.xlsx?$/i.test(f_input_file)) { probs.push(&#x22;INPUT_BREAKS_FILE is not an Excel file: &#x22; + f_input_file); }&#xd;&#xa;var f_valid = (probs.length == 0) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var f_validation_msg = probs.join(&#x22;; &#x22;);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
