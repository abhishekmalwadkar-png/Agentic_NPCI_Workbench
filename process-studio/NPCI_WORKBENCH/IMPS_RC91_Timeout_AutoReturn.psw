      <field><name>REVERSAL_STATUS</name><rename>REVERSAL_STATUS</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>POSTED_AMOUNT</name><rename>POSTED_AMOUNT</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>API_RESPONSE</name><rename>API_RESPONSE</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>AUDIT_TS</name><rename>AUDIT_TS</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
