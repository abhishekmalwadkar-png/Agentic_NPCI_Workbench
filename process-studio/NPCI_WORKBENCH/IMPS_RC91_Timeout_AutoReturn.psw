  <step>
    <name>MJSV_Build_Reversal_Payload</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function __txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function __pv(n) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return __txt(String(getVariable(n, &#x22;&#x22;)).split(token).join(base)).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function __fileOk(p) { if (__txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(__txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function __latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;function __files(dir, prefixes) { var out = []; for (var i = 0; i &lt; prefixes.length; i++) { var p = __latest(dir, prefixes[i], g_runStart); if (p != &#x22;&#x22;) { out.push(p); } } return out.join(&#x22;,&#x22;); }&#xd;&#xa;// Build the Finacle credit-reversal JSON payload (Rhino ES5)&#xd;&#xa;function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v); if (t == &#x22;&#x22;) { return null; } var x = parseFloat(t); return isNaN(x) ? null : x; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;); }&#xd;&#xa;function money(v) { var x = num(v); return (x == null) ? &#x22;null&#x22; : x.toFixed(2); }&#xd;&#xa;var f_request_url = txt(getVariable(&#x22;FINACLE_API_ENDPOINT&#x22;, &#x22;&#x22;));&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var REVERSAL_REQUEST_ID = &#x22;REV-&#x22; + txt(RRN);&#xd;&#xa;var REVERSAL_REASON = (txt(BREAK_CATEGORY) == &#x22;DEEMED_FAILURE&#x22;) ? &#x22;DEEMED_FAILURE_AUTO_RETURN&#x22; : &#x22;RC91_TIMEOUT_AUTO_RETURN&#x22;;&#xd;&#xa;var baseDir = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;));&#xd;&#xa;var f_result_files = __files(__pv(&#x22;OUTPUT_DIR&#x22;), [&#x22;Reversal_Audit_IMPS_&#x22;, &#x22;Reversal_API_Errors_IMPS_&#x22;]);&#xd;&#xa;var f_reversal_payload = &#x22;{&#x22;&#xd;&#xa;  + &#x22;\&#x22;requestId\&#x22;:\&#x22;&#x22; + esc(REVERSAL_REQUEST_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(RRN) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;txnId\&#x22;:\&#x22;&#x22; + esc(TXN_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;utr\&#x22;:\&#x22;&#x22; + esc(UTR) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;cycleId\&#x22;:\&#x22;&#x22; + esc(CYCLE_ID) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;remitterAccount\&#x22;:\&#x22;&#x22; + esc(REMITTER_ACC) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;beneficiaryAccount\&#x22;:\&#x22;&#x22; + esc(BENEFICIARY_ACC) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;amount\&#x22;:&#x22; + money(AMOUNT) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;currency\&#x22;:\&#x22;INR\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;switchRespCode\&#x22;:\&#x22;&#x22; + esc(SWITCH_RESP_CODE) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;breakCategory\&#x22;:\&#x22;&#x22; + esc(BREAK_CATEGORY) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;reversalReason\&#x22;:\&#x22;&#x22; + REVERSAL_REASON + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;channel\&#x22;:\&#x22;IMPS\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;initiatedBy\&#x22;:\&#x22;AE_AUTO_STP\&#x22;&#x22;&#xd;&#xa;  + &#x22;}&#x22;;</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>f_request_url</name><rename>f_request_url</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_content_type</name><rename>f_content_type</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>REVERSAL_REQUEST_ID</name><rename>REVERSAL_REQUEST_ID</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
