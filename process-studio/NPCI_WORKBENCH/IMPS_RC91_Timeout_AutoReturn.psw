  <step>
    <name>MJSV_Tag_Reversal_Outcome</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>&#x2f;&#x2f; Classify the Finacle HTTP response for the audit trail&#xd;&#xa;function txt(v) { return (v == null) ? "" : String(v).replace(/^\s+|\s+$/g, ""); }&#xd;&#xa;var code = parseInt(txt(f_http_status), 10);&#xd;&#xa;var POSTED_FLAG = (!isNaN(code) &amp;&amp; code &gt;= 200 &amp;&amp; code &lt; 300) ? 1 : 0;&#xd;&#xa;var REVERSAL_STATUS = (POSTED_FLAG == 1) ? "POSTED" : "API_REJECTED";&#xd;&#xa;var amt = parseFloat(txt(AMOUNT));&#xd;&#xa;var POSTED_AMOUNT = (POSTED_FLAG == 1 &amp;&amp; !isNaN(amt)) ? amt : 0;&#xd;&#xa;var API_RESPONSE = txt(f_api_response).replace(/[\r\n]+/g, " ").replace(/"/g, "'");&#xd;&#xa;if (API_RESPONSE.length &gt; 500) { API_RESPONSE = API_RESPONSE.substring(0, 500); }&#xd;&#xa;var AUDIT_TS = String(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date()));</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
