<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>IMPS_RC91_Timeout_AutoReturn</name>
    <description>Track A auto-STP: posts Finacle credit reversals for IMPS RC-91 timeout and deemed-failure breaks below the auto-refund threshold, with a full API audit trail.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;09 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;09 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>INPUT_BREAKS_FILE</name>
        <description>Full path of Unmatched_Records_IMPS_&lt;timestamp&gt;.xlsx (o_unmatched_file of the IMPS recon engine)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>N</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>AUTO_REFUND_THRESHOLD</name>
        <description>Maximum amount in INR for auto-refund without maker-checker sign-off</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>50000</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>FINACLE_API_ENDPOINT</name>
        <description>Core Banking REST API endpoint for posting credit reversals</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/finacle/reversal</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for timestamped IMPS Excel outputs (attached to the workflow result)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/IMPS_Recon/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
    </logging_table>
    <size_rowset>10000</size_rowset>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <key_for_session_key>H4sIAAAAAAAA&#x2f;wMAAAAAAAAAAAA&#x3d;</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop><from>XLS_Read_Breaks_File</from><to>GPSV_Get_Refund_Threshold</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>GPSV_Get_Refund_Threshold</from><to>FR_RC91_AutoReturn_Eligible</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_RC91_AutoReturn_Eligible</from><to>MJSV_Build_Reversal_Payload</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_RC91_AutoReturn_Eligible</from><to>DUM_Not_Eligible_For_AutoReturn</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Reversal_Payload</from><to>REST_Post_Finacle_Reversal</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_Post_Finacle_Reversal</from><to>MJSV_Tag_Reversal_Outcome</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Tag_Reversal_Outcome</from><to>XLW_Reversal_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_Reversal_Audit</from><to>GB_Reversal_Summary</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>GB_Reversal_Summary</from><to>MJSV_Build_Reversal_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Reversal_Result</from><to>SWR_AutoReturn_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_Post_Finacle_Reversal</from><to>WTL_Finacle_API_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>WTL_Finacle_API_Error</from><to>XLW_API_Error_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_API_Error_Audit</from><to>SWR_API_Failure</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>RG_Run_Trigger</from><to>MJSV_Validate_Input_File</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Validate_Input_File</from><to>FR_Input_File_Valid</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Input_File_Valid</from><to>DUM_Valid_Input_File</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Input_File_Valid</from><to>WTL_Input_File_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Valid_Input_File</from><to>XLS_Read_Breaks_File</to><enabled>Y</enabled><visible>Y</visible></hop>
  </order>

