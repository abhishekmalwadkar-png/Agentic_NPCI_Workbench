  <step>
    <name>FR_RC91_AutoReturn_Eligible</name>
    <type>FilterRows</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>MJSV_Build_Reversal_Payload</send_true_to>
    <send_false_to>DUM_Not_Eligible_For_AutoReturn</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <conditions>
              <condition>
                <negated>N</negated>
                <leftvalue>SWITCH_RESP_CODE</leftvalue>
                <function>&#x3d;</function>
                <rightvalue/>
                <value><name>constant</name><type>String</type><text>91</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
              </condition>
              <condition>
                <negated>N</negated>
                <operator>OR</operator>
                <leftvalue>BREAK_CATEGORY</leftvalue>
                <function>&#x3d;</function>
                <rightvalue/>
                <value><name>constant</name><type>String</type><text>RC91_TIMEOUT</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
              </condition>
              <condition>
                <negated>N</negated>
                <operator>OR</operator>
                <leftvalue>BREAK_CATEGORY</leftvalue>
                <function>&#x3d;</function>
                <rightvalue/>
                <value><name>constant</name><type>String</type><text>DEEMED_FAILURE</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
              </condition>
            </conditions>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>AMOUNT</leftvalue>
            <function>&lt;</function>
            <rightvalue>f_auto_refund_threshold</rightvalue>
          </condition>
        </conditions>
      </condition>
    </compare>
    <cluster_schema/>
