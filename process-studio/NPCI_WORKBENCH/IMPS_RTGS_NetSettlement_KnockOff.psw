  <step>
    <name>MJSV_Net_Delta_Result</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function __txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function __pv(n) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return __txt(String(getVariable(n, &#x22;&#x22;)).split(token).join(base)).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function __fileOk(p) { if (__txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(__txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function __latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;function __files(dir, prefixes) { var out = []; for (var i = 0; i &lt; prefixes.length; i++) { var p = __latest(dir, prefixes[i], g_runStart); if (p != &#x22;&#x22;) { out.push(p); } } return out.join(&#x22;,&#x22;); }&#xd;&#xa;// Batch-level net delta check (must be exactly 0.00) and result file list&#xd;&#xa;function num(v) { if (v == null) { return 0; } var x = parseFloat(String(v)); return isNaN(x) ? 0 : x; }&#xd;&#xa;var cycle = String(getVariable(&#x22;CYCLE_ID&#x22;, &#x22;&#x22;));&#xd;&#xa;var baseDir = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;));&#xd;&#xa;var totalRows = num(f_total_rows);&#xd;&#xa;var balancedRows = num(f_balanced_rows);&#xd;&#xa;var exceptionRows = num(f_exception_rows);&#xd;&#xa;var totalDr = Math.round(num(f_total_debit) * 100) / 100;&#xd;&#xa;var totalCr = Math.round(num(f_total_credit) * 100) / 100;&#xd;&#xa;var netDelta = Math.round((totalDr - totalCr) * 100) / 100;&#xd;&#xa;var f_total_dr = totalDr.toFixed(2);&#xd;&#xa;var f_total_cr = totalCr.toFixed(2);&#xd;&#xa;var f_net_delta = netDelta.toFixed(2);&#xd;&#xa;var f_balanced_count = balancedRows.toFixed(0);&#xd;&#xa;var f_exception_count = exceptionRows.toFixed(0);&#xd;&#xa;var f_result_files = __files(__pv(&#x22;OUTPUT_DIR&#x22;), [&#x22;Balanced_Ledger_IMPS_&#x22;, &#x22;Variance_Exceptions_IMPS_&#x22;]);&#xd;&#xa;var f_success = &#x22;true&#x22;;&#xd;&#xa;var f_status = &#x22;Complete&#x22;;&#xd;&#xa;var f_message = &#x22;&#x22;;&#xd;&#xa;if (totalRows == 0) { f_status = &#x22;Diverted&#x22;; f_message = &#x22;No matched IMPS records to knock off for cycle &#x22; + cycle; }&#xd;&#xa;else if (netDelta != 0) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_message = &#x22;GL knock-off out of balance for &#x22; + cycle + &#x22; - DR &#x22; + f_total_dr + &#x22; CR &#x22; + f_total_cr + &#x22; net delta &#x22; + f_net_delta; }&#xd;&#xa;else { f_message = &#x22;GL knock-off &#x22; + cycle + &#x22; - &#x22; + f_balanced_count + &#x22; entries balanced DR=CR=&#x22; + f_total_dr + &#x22; net delta 0.00 / &#x22; + f_exception_count + &#x22; variance exceptions&#x22;; }&#xd;&#xa;if (!__fileOk(__pv(&#x22;INPUT_MATCHED_FILE&#x22;))) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_message = &#x22;IMPS Matched_Records file not found or empty: '&#x22; + __pv(&#x22;INPUT_MATCHED_FILE&#x22;) + &#x22;' - pass the Matched_Records_IMPS_&lt;timestamp&gt;.xlsx path&#x22;; }</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
