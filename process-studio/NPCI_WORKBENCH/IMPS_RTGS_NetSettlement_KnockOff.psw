        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>GL-14022</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>GL_SETTLEMENT_ACC</name>
        <description>RBI RTGS Settlement Account</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>GL-11010</default_value>
        <secret>N</secret>
        <optional>Y</optional>
