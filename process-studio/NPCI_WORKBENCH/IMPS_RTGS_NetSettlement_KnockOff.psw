  <step>
    <name>MJSV_Build_GL_Entries</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>&#x2f;&#x2f; Double-entry knock-off: DR suspense GL &#x2f; CR RTGS settlement GL (Rhino ES5)&#xd;&#xa;function txt(v) { return (v == null) ? "" : String(v).replace(/^\s+|\s+$/g, ""); }&#xd;&#xa;function num(v) { var t = txt(v); if (t == "") { return null; } var x = parseFloat(t); return isNaN(x) ? null : x; }&#xd;&#xa;var SETTLEMENT_CYCLE = txt(getVariable("CYCLE_ID", ""));&#xd;&#xa;var DEBIT_ACCOUNT = txt(getVariable("GL_SUSPENSE_ACC", "GL-14022"));&#xd;&#xa;var CREDIT_ACCOUNT = txt(getVariable("GL_SETTLEMENT_ACC", "GL-11010"));&#xd;&#xa;var drRaw = num(NPCI_AMOUNT);&#xd;&#xa;var crRaw = num(GL_AMOUNT);&#xd;&#xa;var DEBIT_AMOUNT = (drRaw == null) ? 0 : Math.round(drRaw * 100) / 100;&#xd;&#xa;var CREDIT_AMOUNT = (crRaw == null) ? 0 : Math.round(crRaw * 100) / 100;&#xd;&#xa;var NET_VARIANCE = Math.round((DEBIT_AMOUNT - CREDIT_AMOUNT) * 100) / 100;&#xd;&#xa;var JOURNAL_REF = "JV-" + SETTLEMENT_CYCLE + "-" + txt(RRN);&#xd;&#xa;var NARRATION = "IMPS net settlement knock-off RRN " + txt(RRN) + " voucher " + txt(RBI_VOUCHER_NO);&#xd;&#xa;var BALANCED_FLAG = (NET_VARIANCE == 0) ? 1 : 0;&#xd;&#xa;var EXCEPTION_FLAG = 1 - BALANCED_FLAG;&#xd;&#xa;var KNOCKOFF_STATUS = (BALANCED_FLAG == 1) ? "KNOCKED_OFF" : "VARIANCE_EXCEPTION";&#xd;&#xa;var LEDGER_DR = (BALANCED_FLAG == 1) ? DEBIT_AMOUNT : 0;&#xd;&#xa;var LEDGER_CR = (BALANCED_FLAG == 1) ? CREDIT_AMOUNT : 0;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>SETTLEMENT_CYCLE</name><rename>SETTLEMENT_CYCLE</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>JOURNAL_REF</name><rename>JOURNAL_REF</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>DEBIT_ACCOUNT</name><rename>DEBIT_ACCOUNT</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>DEBIT_AMOUNT</name><rename>DEBIT_AMOUNT</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>CREDIT_ACCOUNT</name><rename>CREDIT_ACCOUNT</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>CREDIT_AMOUNT</name><rename>CREDIT_AMOUNT</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>NET_VARIANCE</name><rename>NET_VARIANCE</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>NARRATION</name><rename>NARRATION</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>KNOCKOFF_STATUS</name><rename>KNOCKOFF_STATUS</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>BALANCED_FLAG</name><rename>BALANCED_FLAG</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>EXCEPTION_FLAG</name><rename>EXCEPTION_FLAG</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>LEDGER_DR</name><rename>LEDGER_DR</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>LEDGER_CR</name><rename>LEDGER_CR</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
    </fields>
    <cluster_schema/>
