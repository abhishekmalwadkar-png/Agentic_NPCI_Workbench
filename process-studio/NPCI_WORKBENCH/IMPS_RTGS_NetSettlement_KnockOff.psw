    <fields>
      <field><name>JOURNAL_REF</name><type>String</type><format></format><title>JOURNAL_REF</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>SETTLEMENT_CYCLE</name><type>String</type><format></format><title>SETTLEMENT_CYCLE</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>RRN</name><type>String</type><format></format><title>RRN</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>UTR</name><type>String</type><format></format><title>UTR</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>RBI_VOUCHER_NO</name><type>String</type><format></format><title>RBI_VOUCHER_NO</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>NET_CYCLE_ID</name><type>String</type><format></format><title>NET_CYCLE_ID</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>DEBIT_ACCOUNT</name><type>String</type><format></format><title>DEBIT_ACCOUNT</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>DEBIT_AMOUNT</name><type>Number</type><format>0.00</format><title>DEBIT_AMOUNT</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>CREDIT_ACCOUNT</name><type>String</type><format></format><title>CREDIT_ACCOUNT</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
      <field><name>CREDIT_AMOUNT</name><type>Number</type><format>0.00</format><title>CREDIT_AMOUNT</title><titleStyleCell/><styleCell/><commentField/><commentAuthorField/><formula>N</formula><hyperlinkField/></field>
