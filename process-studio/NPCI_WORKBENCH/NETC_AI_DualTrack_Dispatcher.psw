  <step>
    <name>MJSV_AI_RootCause_Router</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var cat = txt(BREAK_CATEGORY);&#xd;&#xa;var amt = num(TXN_AMOUNT); if (amt == null) { amt = num(TOLL_AMOUNT) || 0; }&#xd;&#xa;var variance = num(AMOUNT_VARIANCE);&#xd;&#xa;var varAbs = (variance == null) ? 0 : Math.abs(variance);&#xd;&#xa;var autoLimit = pnum(&#x22;AUTO_REFUND_LIMIT&#x22;, 1000);&#xd;&#xa;var hitlLimit = pnum(&#x22;HITL_THRESHOLD&#x22;, 5000);&#xd;&#xa;var slaMin = pnum(&#x22;REFUND_SLA_MINUTES&#x22;, 5);&#xd;&#xa;var doubleDebit = (cat == &#x22;MULTI_ANTENNA_DOUBLE_DEBIT&#x22;);&#xd;&#xa;var tagRisk = (cat == &#x22;BLACKLISTED_TAG_PASSAGE&#x22; || cat == &#x22;LOW_BALANCE_OVERDRAFT&#x22;);&#xd;&#xa;var feeDispute = (cat == &#x22;CONCESSIONAIRE_FEE_DISPUTE&#x22;);&#xd;&#xa;var ROOT_CAUSE = &#x22;&#x22;; var RCA_CONFIDENCE = 0.0;&#xd;&#xa;if (doubleDebit) { ROOT_CAUSE = &#x22;Adjacent-lane antenna re-read the same EPC &#x22; + txt(READ_GAP_SEC) + &#x22;s later (&#x22; + txt(PREV_LANE_ID) + &#x22; -&gt; &#x22; + txt(LANE_ID) + &#x22;) - plaza raised duplicate toll&#x22;; RCA_CONFIDENCE = 0.96; }&#xd;&#xa;else if (cat == &#x22;BLACKLISTED_TAG_PASSAGE&#x22;) { ROOT_CAUSE = &#x22;Plaza tag-status cache stale - blacklisted tag allowed passage and debited&#x22;; RCA_CONFIDENCE = 0.90; }&#xd;&#xa;else if (cat == &#x22;LOW_BALANCE_OVERDRAFT&#x22;) { ROOT_CAUSE = &#x22;Low-balance tag passed under offline threshold - wallet overdrawn to INR &#x22; + money(WALLET_BALANCE); RCA_CONFIDENCE = 0.88; }&#xd;&#xa;else if (feeDispute) { ROOT_CAUSE = &#x22;Vehicle class / fee mismatch between plaza AVC and concessionaire GL-9908 - variance INR &#x22; + varAbs.toFixed(2); RCA_CONFIDENCE = 0.84; }&#xd;&#xa;else if (cat == &#x22;WALLET_DEBIT_NO_PLAZA_CLEARANCE&#x22;) { ROOT_CAUSE = &#x22;Wallet debited without a plaza RFID read - possible cloned tag or mapper replay&#x22;; RCA_CONFIDENCE = 0.80; }&#xd;&#xa;else { ROOT_CAUSE = txt(BREAK_REASON); RCA_CONFIDENCE = 0.60; }&#xd;&#xa;var TRACK = &#x22;PARKED_OPS_REVIEW&#x22;; var TRACK_REASON = &#x22;&#x22;; var PRIORITY = &#x22;LOW&#x22;;&#xd;&#xa;if (doubleDebit &amp;&amp; amt &lt; autoLimit) { TRACK = &#x22;AUTO_REVERSAL&#x22;; TRACK_REASON = &#x22;Multi-antenna double toll under INR &#x22; + autoLimit.toFixed(0) + &#x22; - instant wallet refund within &#x22; + slaMin.toFixed(0) + &#x22; min&#x22;; PRIORITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (tagRisk) { TRACK = &#x22;HITL&#x22;; TRACK_REASON = cat + &#x22; - requires issuer review&#x22;; PRIORITY = (cat == &#x22;BLACKLISTED_TAG_PASSAGE&#x22;) ? &#x22;CRITICAL&#x22; : &#x22;HIGH&#x22;; }&#xd;&#xa;else if (feeDispute &amp;&amp; Math.max(amt, varAbs) &gt; hitlLimit) { TRACK = &#x22;HITL&#x22;; TRACK_REASON = &#x22;Concessionaire fee dispute above INR &#x22; + hitlLimit.toFixed(0); PRIORITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (doubleDebit) { TRACK_REASON = &#x22;Double toll at or above auto-refund limit - operations review&#x22;; PRIORITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else { TRACK_REASON = &#x22;Not eligible for auto-refund or HITL - operations review&#x22;; }&#xd;&#xa;var IS_HITL = (TRACK == &#x22;HITL&#x22;) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var IS_AUTO = (TRACK == &#x22;AUTO_REVERSAL&#x22;) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var DOSSIER_ID = &#x22;NETC-&#x22; + ((TRACK == &#x22;HITL&#x22;) ? &#x22;HITL&#x22; : &#x22;RFD&#x22;) + &#x22;-&#x22; + txt(RRN);&#xd;&#xa;var EVIDENCE_HASH = sha256([txt(RRN), txt(TXN_ID), txt(EPC), txt(TAG_ID), txt(PLAZA_ID), txt(LANE_ID), txt(READER_TIMESTAMP), money(TOLL_AMOUNT), txt(WALLET_DEBIT_STATUS), money(WALLET_BALANCE), money(GL_AMOUNT), txt(SETTLEMENT_STATUS), cat, txt(BREAK_REASON)].join(&#x22;|&#x22;));&#xd;&#xa;var CCTV_REF = &#x22;CCTV-&#x22; + txt(PLAZA_ID) + &#x22;-&#x22; + txt(LANE_ID) + &#x22;-&#x22; + txt(READER_TIMESTAMP).replace(/[^0-9]/g, &#x22;&#x22;);&#xd;&#xa;var sla = java.util.Calendar.getInstance(); sla.add(java.util.Calendar.MINUTE, slaMin);&#xd;&#xa;var slaDeadline = String(new java.text.SimpleDateFormat(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;).format(sla.getTime()));&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var f_idempotency_key = DOSSIER_ID;&#xd;&#xa;var f_request_url = (TRACK == &#x22;HITL&#x22;) ? pv(&#x22;NPCI_QUEUE_URL&#x22;) : pv(&#x22;NPCI_URL&#x22;);&#xd;&#xa;var f_payload = &#x22;&#x22;;&#xd;&#xa;if (TRACK == &#x22;AUTO_REVERSAL&#x22;) {&#xd;&#xa;  f_payload = &#x22;{\&#x22;track\&#x22;:\&#x22;AUTO_REVERSAL\&#x22;,\&#x22;rail\&#x22;:\&#x22;NETC\&#x22;,\&#x22;action\&#x22;:\&#x22;FASTAG_WALLET_INSTANT_REFUND\&#x22;,\&#x22;status\&#x22;:\&#x22;AUTO_APPROVED\&#x22;,\&#x22;instructionId\&#x22;:\&#x22;&#x22; + DOSSIER_ID + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(RRN) + &#x22;\&#x22;,\&#x22;txnId\&#x22;:\&#x22;&#x22; + esc(TXN_ID) + &#x22;\&#x22;,\&#x22;epc\&#x22;:\&#x22;&#x22; + esc(EPC) + &#x22;\&#x22;,\&#x22;tagId\&#x22;:\&#x22;&#x22; + esc(TAG_ID) + &#x22;\&#x22;,\&#x22;accNo\&#x22;:\&#x22;&#x22; + esc(ACC_NO) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;amount\&#x22;:&#x22; + amt.toFixed(2) + &#x22;,\&#x22;plazaId\&#x22;:\&#x22;&#x22; + esc(PLAZA_ID) + &#x22;\&#x22;,\&#x22;laneId\&#x22;:\&#x22;&#x22; + esc(LANE_ID) + &#x22;\&#x22;,\&#x22;duplicateOfLane\&#x22;:\&#x22;&#x22; + esc(PREV_LANE_ID) + &#x22;\&#x22;,\&#x22;readGapSec\&#x22;:&#x22; + jnum(READ_GAP_SEC) + &#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;rootCause\&#x22;:\&#x22;&#x22; + esc(ROOT_CAUSE) + &#x22;\&#x22;,\&#x22;refundSlaDeadline\&#x22;:\&#x22;&#x22; + slaDeadline + &#x22;\&#x22;,\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;}&#x22;;&#xd;&#xa;} else if (TRACK == &#x22;HITL&#x22;) {&#xd;&#xa;  f_payload = &#x22;{\&#x22;dossierId\&#x22;:\&#x22;&#x22; + DOSSIER_ID + &#x22;\&#x22;,\&#x22;track\&#x22;:\&#x22;HITL\&#x22;,\&#x22;rail\&#x22;:\&#x22;NETC\&#x22;,\&#x22;status\&#x22;:\&#x22;PENDING_APPROVAL\&#x22;,\&#x22;priority\&#x22;:\&#x22;&#x22; + PRIORITY + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(RRN) + &#x22;\&#x22;,\&#x22;txnId\&#x22;:\&#x22;&#x22; + esc(TXN_ID) + &#x22;\&#x22;,\&#x22;epc\&#x22;:\&#x22;&#x22; + esc(EPC) + &#x22;\&#x22;,\&#x22;accNo\&#x22;:\&#x22;&#x22; + esc(ACC_NO) + &#x22;\&#x22;,\&#x22;amount\&#x22;:&#x22; + amt.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;breakCategory\&#x22;:\&#x22;&#x22; + esc(cat) + &#x22;\&#x22;,\&#x22;routingReason\&#x22;:\&#x22;&#x22; + esc(TRACK_REASON) + &#x22;\&#x22;,\&#x22;rootCause\&#x22;:\&#x22;&#x22; + esc(ROOT_CAUSE) + &#x22;\&#x22;,\&#x22;rcaConfidence\&#x22;:&#x22; + RCA_CONFIDENCE.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;evidence\&#x22;:{\&#x22;epcReaderLog\&#x22;:{\&#x22;tagId\&#x22;:\&#x22;&#x22; + esc(TAG_ID) + &#x22;\&#x22;,\&#x22;plazaId\&#x22;:\&#x22;&#x22; + esc(PLAZA_ID) + &#x22;\&#x22;,\&#x22;laneId\&#x22;:\&#x22;&#x22; + esc(LANE_ID) + &#x22;\&#x22;,\&#x22;readerTimestamp\&#x22;:\&#x22;&#x22; + esc(READER_TIMESTAMP) + &#x22;\&#x22;,\&#x22;doubleReadFlag\&#x22;:\&#x22;&#x22; + esc(DOUBLE_READ_FLAG) + &#x22;\&#x22;},&#x22;&#xd;&#xa;    + &#x22;\&#x22;plazaCctvRef\&#x22;:\&#x22;&#x22; + esc(CCTV_REF) + &#x22;\&#x22;,\&#x22;mapperStatus\&#x22;:\&#x22;&#x22; + esc(MAPPER_STATUS) + &#x22;\&#x22;,\&#x22;acquirerId\&#x22;:\&#x22;&#x22; + esc(ACQUIRER_ID) + &#x22;\&#x22;,\&#x22;walletDebitStatus\&#x22;:\&#x22;&#x22; + esc(WALLET_DEBIT_STATUS) + &#x22;\&#x22;,&#x22;&#xd;&#xa;    + &#x22;\&#x22;walletBalance\&#x22;:&#x22; + jnum(WALLET_BALANCE) + &#x22;,\&#x22;tollAmount\&#x22;:&#x22; + jnum(TOLL_AMOUNT) + &#x22;,\&#x22;glAmount\&#x22;:&#x22; + jnum(GL_AMOUNT) + &#x22;,\&#x22;variance\&#x22;:&#x22; + jnum(AMOUNT_VARIANCE) + &#x22;,\&#x22;breakReason\&#x22;:\&#x22;&#x22; + esc(BREAK_REASON) + &#x22;\&#x22;},&#x22;&#xd;&#xa;    + &#x22;\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;,\&#x22;createdAt\&#x22;:\&#x22;&#x22; + nowTs(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;) + &#x22;\&#x22;}&#x22;;&#xd;&#xa;}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
