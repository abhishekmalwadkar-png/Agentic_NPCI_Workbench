        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var code = parseInt(txt(f_http_status), 10);&#xd;&#xa;var ok = (!isNaN(code) &amp;&amp; code &gt;= 200 &amp;&amp; code &lt; 300);&#xd;&#xa;var HTTP_STATUS = isNaN(code) ? &#x22;N/A&#x22; : String(code);&#xd;&#xa;var DISPATCH_STATUS = ok ? ((TRACK == &#x22;HITL&#x22;) ? &#x22;QUEUED_FOR_HITL&#x22; : &#x22;WALLET_REFUND_DISPATCHED&#x22;) : &#x22;API_REJECTED&#x22;;&#xd;&#xa;var DISPATCHED_FLAG = ok ? 1 : 0;&#xd;&#xa;var FAILED_FLAG = ok ? 0 : 1;&#xd;&#xa;var AUTO_FLAG = (ok &amp;&amp; TRACK == &#x22;AUTO_REVERSAL&#x22;) ? 1 : 0;&#xd;&#xa;var HITL_FLAG = (ok &amp;&amp; TRACK == &#x22;HITL&#x22;) ? 1 : 0;&#xd;&#xa;var a = num(TXN_AMOUNT);&#xd;&#xa;var DISPATCHED_AMOUNT = (ok &amp;&amp; a != null) ? a : 0;&#xd;&#xa;var API_RESPONSE = txt(f_api_response).replace(/[\r\n]+/g, &#x22; &#x22;); if (API_RESPONSE.length &gt; 500) { API_RESPONSE = API_RESPONSE.substring(0, 500); }&#xd;&#xa;var AUDIT_TS = nowTs(&#x22;yyyy-MM-dd HH:mm:ss&#x22;);</jsScript_script>
