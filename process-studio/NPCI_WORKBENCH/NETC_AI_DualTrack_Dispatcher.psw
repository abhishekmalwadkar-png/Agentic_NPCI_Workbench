<transformation>
  <info>
    <name>NETC_AI_DualTrack_Dispatcher</name>
    <description>NETC AI root-cause and dual-track routing - instant wallet refunds for double toll reads, HITL evidence packages for tag risk and fee disputes.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>UnMatched_File_Path</name>
        <description>Full path of Unmatched_NETC_Records_&lt;TIMESTAMP&gt;.xlsx produced by the recon engine</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>N</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>NPCI_URL</name>
        <description>FASTag wallet instant-refund endpoint for the Auto-Reversal track</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/recon/run</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>NPCI_QUEUE_URL</name>
        <description>HITL cockpit queue endpoint for evidence packages</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/queue</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>AUTO_REFUND_LIMIT</name>
        <description>Instant refund ceiling in INR for double-toll reads (strictly below)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>1000</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>HITL_THRESHOLD</name>
        <description>Concessionaire fee dispute threshold in INR for HITL (strictly above)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>5000</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>REFUND_SLA_MINUTES</name>
        <description>Wallet refund SLA in minutes</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>5</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
