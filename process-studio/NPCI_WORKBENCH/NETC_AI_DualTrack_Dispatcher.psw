        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/NETC_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
