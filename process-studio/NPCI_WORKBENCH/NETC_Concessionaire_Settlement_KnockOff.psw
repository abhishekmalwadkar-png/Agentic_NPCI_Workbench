<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>NETC_Concessionaire_Settlement_KnockOff</name>
    <description>NETC concessionaire settlement knock-off - per-plaza net payout after acquirer interchange, posted as a balancing journal.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>Matched_File_Path</name>
        <description>Full path of Matched_NETC_Records_&lt;TIMESTAMP&gt;.xlsx produced by the recon engine</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value></default_value>
        <secret>N</secret>
        <optional>N</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>NPCI_URL</name>
        <description>Settlement / GL API that receives the concessionaire settlement journal</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/recon/run</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
      <parameter>
        <name>ACQUIRER_INTERCHANGE_PCT</name>
        <description>Acquirer interchange fee as % of gross toll, deducted from the concessionaire payout</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>1.5</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for the settlement journal audit and rejected rows</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/NETC_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
