x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var probs = [];&#xd;&#xa;var inFile = pv(&#x22;Matched_File_Path&#x22;).replace(/\\/g, &#x22;/&#x22;);&#xd;&#xa;if (!fileOk(inFile)) { probs.push(&#x22;Matched_File_Path not found or empty: '&#x22; + inFile + &#x22;'&#x22;); }&#xd;&#xa;if (!urlOk(pv(&#x22;NPCI_URL&#x22;))) { probs.push(&#x22;NPCI_URL is not a valid http(s) URL&#x22;); }&#xd;&#xa;var pct = pnum(&#x22;ACQUIRER_INTERCHANGE_PCT&#x22;, 1.5);&#xd;&#xa;var txnCount = num(t_txn_count) || 0; var nonStp = num(t_non_stp) || 0; var unbalanced = num(t_unbalanced) || 0;&#xd;&#xa;var GROSS_TOLL = r2(num(t_gross) || 0);&#xd;&#xa;var INTERCHANGE_TOTAL = r2(num(t_fee) || 0);&#xd;&#xa;var NET_PAYOUT_TOTAL = r2(num(t_net) || 0);&#xd;&#xa;var DELTA = r2(num(t_variance) || 0);&#xd;&#xa;var PLAZA_POOLS = (num(t_pools) || 0).toFixed(0);&#xd;&#xa;var TXN_COUNT = txnCount.toFixed(0);&#xd;&#xa;var runId = &#x22;NETC-KO-&#x22; + nowTs(&#x22;yyyyMMddHHmmss&#x22;);&#xd;&#xa;var POST_READY = &#x22;N&#x22;; var GATE_STATUS = &#x22;&#x22;; var GATE_MESSAGE = &#x22;&#x22;;&#xd;&#xa;if (probs.length &gt; 0) { GATE_STATUS = &#x22;Failure&#x22;; GATE_MESSAGE = &#x22;NETC knock-off not posted - &#x22; + probs.join(&#x22;; &#x22;); }&#xd;&#xa;else if (txnCount == 0) { GATE_STATUS = &#x22;Diverted&#x22;; GATE_MESSAGE = &#x22;NETC knock-off not posted - matched file has no STP records&#x22;; }&#xd;&#xa;else if (nonStp &gt; 0) { GATE_STATUS = &#x22;Failure&#x22;; GATE_MESSAGE = &#x22;NETC knock-off not posted - matched file contains &#x22; + nonStp.toFixed(0) + &#x22; non-STP rows&#x22;; }&#xd;&#xa;else if (unbalanced &gt; 0) { GATE_STATUS = &#x22;Failure&#x22;; GATE_MESSAGE = &#x22;NETC knock-off blocked - &#x22; + unbalanced.toFixed(0) + &#x22; plaza pool(s) not balanced against GL-9908 (net delta &#x22; + DELTA.toFixed(2) + &#x22;)&#x22;; }&#xd;&#xa;else { POST_READY = &#x22;Y&#x22;; GATE_STATUS = &#x22;Ready&#x22;; GATE_MESSAGE = &#x22;All &#x22; + PLAZA_POOLS + &#x22; plaza pools balanced&#x22;; }&#xd;&#xa;var EVIDENCE_HASH = sha256([runId, TXN_COUNT, GROSS_TOLL.toFixed(2), INTERCHANGE_TOTAL.toFixed(2), NET_PAYOUT_TOTAL.toFixed(2), inFile].join(&#x22;|&#x22;));&#xd;&#xa;var f_request_url = pv(&#x22;NPCI_URL&#x22;);&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var f_idempotency_key = runId;&#xd;&#xa;var f_payload = &#x22;{\&#x22;rail\&#x22;:\&#x22;NETC\&#x22;,\&#x22;action\&#x22;:\&#x22;CONCESSIONAIRE_SETTLEMENT_KNOCKOFF\&#x22;,\&#x22;runId\&#x22;:\&#x22;&#x22; + runId + &#x22;\&#x22;,\&#x22;glAccount\&#x22;:\&#x22;GL-9908\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;sourceFile\&#x22;:\&#x22;&#x22; + esc(inFile) + &#x22;\&#x22;,\&#x22;txnCount\&#x22;:&#x22; + TXN_COUNT + &#x22;,\&#x22;interchangePct\&#x22;:&#x22; + pct.toFixed(3) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;grossToll\&#x22;:&#x22; + GROSS_TOLL.toFixed(2) + &#x22;,\&#x22;acquirerInterchange\&#x22;:&#x22; + INTERCHANGE_TOTAL.toFixed(2) + &#x22;,\&#x22;netConcessionairePayout\&#x22;:&#x22; + NET_PAYOUT_TOTAL.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;entries\&#x22;:[&#x22;&#xd;&#xa;  + &#x22;{\&#x22;leg\&#x22;:\&#x22;DR\&#x22;,\&#x22;account\&#x22;:\&#x22;GL-9908-NETC-TOLL-POOL\&#x22;,\&#x22;amount\&#x22;:&#x22; + GROSS_TOLL.toFixed(2) + &#x22;},&#x22;&#xd;&#xa;  + &#x22;{\&#x22;leg\&#x22;:\&#x22;CR\&#x22;,\&#x22;account\&#x22;:\&#x22;CONCESSIONAIRE-PAYABLE\&#x22;,\&#x22;amount\&#x22;:&#x22; + NET_PAYOUT_TOTAL.toFixed(2) + &#x22;},&#x22;&#xd;&#xa;  + &#x22;{\&#x22;leg\&#x22;:\&#x22;CR\&#x22;,\&#x22;account\&#x22;:\&#x22;ACQUIRER-INTERCHANGE-INCOME\&#x22;,\&#x22;amount\&#x22;:&#x22; + INTERCHANGE_TOTAL.toFixed(2) + &#x22;}],&#x22;&#xd;&#xa;  + &#x22;\&#x22;plazaPools\&#x22;:[&#x22; + txt(t_fragments) + &#x22;],\&#x22;closeClearingCycle\&#x22;:true,&#x22;&#xd;&#xa;  + &#x22;\&#x22;evidenceHash\&#x22;:\&#x22;&#x22; + EVIDENCE_HASH + &#x22;\&#x22;,\&#x22;postedAt\&#x22;:\&#x22;&#x22; + nowTs(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;) + &#x22;\&#x22;}&#x22;;</jsScript_script>
      </jsScript>
    </jsScripts>
