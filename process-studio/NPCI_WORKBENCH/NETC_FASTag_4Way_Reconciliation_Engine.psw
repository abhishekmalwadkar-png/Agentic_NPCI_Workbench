  <step>
    <name>MJSV_Build_Recon_Result</name>
    <type>ScriptValueMod</type>
    <description />
    <customErrorMessage />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? "" : String(v).replace(/^\s+|\s+$/g, ""); }
function num(v) { var t = txt(v).replace(/,/g, ""); if (t == "") { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }
function r2(n) { return Math.round(n * 100) / 100; }
function esc(v) { return txt(v).replace(/\\/g, "\\\\").replace(/"/g, "\\\"").replace(/[\r\n\t]+/g, " "); }
function money(v) { var n = num(v); return (n == null) ? "0.00" : n.toFixed(2); }
function jnum(v) { var n = num(v); return (n == null) ? "null" : String(r2(n)); }
function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }
function sha256(s) { var md = java.security.MessageDigest.getInstance("SHA-256"); var d = md.digest(new java.lang.String(s).getBytes("UTF-8")); var h = ""; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = "0" + b; } h = h + b; } return h; }
function pv(name) { var token = "$" + "{Internal.Entry.Current.Directory}"; var base = String(getVariable("Internal.Entry.Current.Directory", "")); return txt(String(getVariable(name, "")).split(token).join(base)); }
function dirOf(name) { return pv(name).replace(/\\/g, "/").replace(/\/+$/, ""); }
function fileOk(p) { if (txt(p) == "") { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }
function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }
function enc(v) { return String(java.net.URLEncoder.encode(txt(v), "UTF-8")); }
function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf("?") &gt;= 0) ? "&amp;" : "?") + q; }
function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }

function latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return ""; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? "" : String(best.getAbsolutePath()).replace(/\\/g, "/"); }

var inDir = dirOf("INPUT_DIR");
var outDir = dirOf("OUTPUT_DIR");
var cycle = pv("CYCLE_ID");
var feeds = ["Plaza_Lane_RFID_Trans.xml", "NPCI_NETC_Mapper_Clearing.csv", "FASTag_Wallet_CBS_Dump.csv", "NETC_Concessionaire_GL9908.csv"];
var missing = [];
for (var i = 0; i &lt; feeds.length; i++) { if (!fileOk(inDir + "/" + feeds[i])) { missing.push(feeds[i]); } }
var total = num(f_total_rows) || 0;
var matched = num(f_matched_rows) || 0;
var dbl = num(f_double_debits) || 0;
var f_total_txns = total.toFixed(0);
var f_matched_txns = matched.toFixed(0);
var f_break_txns = (total - matched).toFixed(0);
var f_double_debit_txns = dbl.toFixed(0);
var f_matched_file = latest(outDir, "Matched_NETC_Records_", g_runStart);
var f_unmatched_file = latest(outDir, "Unmatched_NETC_Records_", g_runStart);
var files = []; if (f_matched_file != "") { files.push(f_matched_file); } if (f_unmatched_file != "") { files.push(f_unmatched_file); }
var f_result_files = files.join(",");
var f_success = "true"; var f_status = "Complete"; var f_message = "";
if (missing.length &gt; 0) { f_success = "false"; f_status = "Failure"; f_message = "NETC recon aborted - missing or empty inbound feed(s): " + missing.join(", "); }
else if (total == 0) { f_status = "Diverted"; f_message = "NETC recon - no clearing records found in NPCI_NETC_Mapper_Clearing.csv"; }
else { f_message = "NETC FASTag 4-way recon " + cycle + " - " + f_total_txns + " txns / " + f_matched_txns + " matched STP / " + f_break_txns + " exceptions (" + f_double_debit_txns + " multi-antenna double debits)"; }</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>f_total_txns</name><rename>f_total_txns</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_matched_txns</name><rename>f_matched_txns</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
