  <step>
    <name>MJSV_Validate_Feeds</name>
    <type>ScriptValueMod</type>
    <description />
    <customErrorMessage />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
