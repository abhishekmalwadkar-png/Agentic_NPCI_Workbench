<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>NETC_FASTag_4Way_Reconciliation_Engine</name>
    <description>NETC FASTag 4-way reconciliation of plaza RFID reads, NPCI mapper clearing, FASTag wallet CBS and GL-9908 with multi-antenna double-debit detection.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>INPUT_DIR</name>
        <description>Folder holding the NETC inbound feeds (1 XML + 3 CSV)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/NETC_reconn</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for Matched / Unmatched NETC xlsx outputs</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/NETC_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>DOUBLE_READ_WINDOW_SEC</name>
        <description>Window in seconds for multi-antenna double-read detection (strictly below)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>60</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>CYCLE_ID</name>
        <description>Clearing cycle identifier (informational, stamped in the result)</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>NETC-20261112-CY01</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>Y</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
    </logging_table>
    <size_rowset>10000</size_rowset>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <key_for_session_key>H4sIAAAAAAAA&#x2f;wMAAAAAAAAAAAA&#x3d;</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop><from>RG_Run_Trigger</from><to>MJSV_Validate_Feeds</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Validate_Feeds</from><to>FR_Feeds_Present</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Feeds_Present</from><to>DUM_Feed_Fanout</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Feeds_Present</from><to>WTL_Missing_Feeds</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>XML_Read_Plaza_RFID</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_NETC_Mapper</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_FASTag_Wallet</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>DUM_Feed_Fanout</from><to>CSV_Read_GL9908_Pool</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XML_Read_Plaza_RFID</from><to>SR_Sort_Plaza_EPC_Time</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Plaza_EPC_Time</from><to>MJSV_Detect_MultiAntenna_Reads</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Detect_MultiAntenna_Reads</from><to>SR_Sort_Plaza_Key</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_NETC_Mapper</from><to>SR_Sort_Mapper_EPC_Txn</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Mapper_EPC_Txn</from><to>MJSV_Sequence_Mapper_EPC</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Sequence_Mapper_EPC</from><to>SR_Sort_Mapper_Key</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Mapper_Key</from><to>MJ_Join_Plaza_On_EPC</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Plaza_Key</from><to>MJ_Join_Plaza_On_EPC</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJ_Join_Plaza_On_EPC</from><to>SR_Sort_Cleared_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_FASTag_Wallet</from><to>SR_Sort_Wallet_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_GL9908_Pool</from><to>SR_Sort_GL_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Cleared_RRN</from><to>MJ_Join_Wallet_On_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_Wallet_RRN</from><to>MJ_Join_Wallet_On_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJ_Join_Wallet_On_RRN</from><to>MJ_Join_GL9908_On_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SR_Sort_GL_RRN</from><to>MJ_Join_GL9908_On_RRN</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJ_Join_GL9908_On_RRN</from><to>MJSV_Classify_4Way</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Classify_4Way</from><to>MJSV_Flag_Double_Debit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Flag_Double_Debit</from><to>FR_Is_Matched_STP</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Is_Matched_STP</from><to>XLW_Matched_NETC</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Is_Matched_STP</from><to>XLW_Unmatched_NETC</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_Matched_NETC</from><to>GB_Recon_Summary</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_Unmatched_NETC</from><to>GB_Recon_Summary</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>GB_Recon_Summary</from><to>MJSV_Build_Recon_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Recon_Result</from><to>SWR_Recon_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XML_Read_Plaza_RFID</from><to>WTL_Plaza_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_NETC_Mapper</from><to>WTL_Mapper_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_FASTag_Wallet</from><to>WTL_Wallet_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>CSV_Read_GL9908_Pool</from><to>WTL_GL_Row_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
  </order>

  <step>
    <name>RG_Run_Trigger</name>
    <type>RowGenerator</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field><name>f_trigger</name><type>String</type><format/><currency/><decimal/><group/><nullif>RUN</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
