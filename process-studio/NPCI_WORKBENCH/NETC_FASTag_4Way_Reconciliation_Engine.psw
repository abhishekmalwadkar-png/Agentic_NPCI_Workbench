  <step>
    <name>MJSV_Build_Recon_Result</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;function latest(dir, prefix, since) { var d = new java.io.File(dir); var list = d.listFiles(); var best = null; if (list == null) { return &#x22;&#x22;; } for (var i = 0; i &lt; list.length; i++) { var f = list[i]; var n = String(f.getName()); if (n.indexOf(prefix) == 0 &amp;&amp; /\.xlsx$/i.test(n) &amp;&amp; f.lastModified() &gt;= since) { if (best == null || f.lastModified() &gt; best.lastModified()) { best = f; } } } return (best == null) ? &#x22;&#x22; : String(best.getAbsolutePath()).replace(/\\/g, &#x22;/&#x22;); }&#xd;&#xa;&#xd;&#xa;var inDir = dirOf(&#x22;INPUT_DIR&#x22;);&#xd;&#xa;var outDir = dirOf(&#x22;OUTPUT_DIR&#x22;);&#xd;&#xa;var cycle = pv(&#x22;CYCLE_ID&#x22;);&#xd;&#xa;var feeds = [&#x22;Plaza_Lane_RFID_Trans.xml&#x22;, &#x22;NPCI_NETC_Mapper_Clearing.csv&#x22;, &#x22;FASTag_Wallet_CBS_Dump.csv&#x22;, &#x22;NETC_Concessionaire_GL9908.csv&#x22;];&#xd;&#xa;var missing = [];&#xd;&#xa;for (var i = 0; i &lt; feeds.length; i++) { if (!fileOk(inDir + &#x22;/&#x22; + feeds[i])) { missing.push(feeds[i]); } }&#xd;&#xa;var total = num(f_total_rows) || 0;&#xd;&#xa;var matched = num(f_matched_rows) || 0;&#xd;&#xa;var dbl = num(f_double_debits) || 0;&#xd;&#xa;var f_total_txns = total.toFixed(0);&#xd;&#xa;var f_matched_txns = matched.toFixed(0);&#xd;&#xa;var f_break_txns = (total - matched).toFixed(0);&#xd;&#xa;var f_double_debit_txns = dbl.toFixed(0);&#xd;&#xa;var f_matched_file = latest(outDir, &#x22;Matched_NETC_Records_&#x22;, g_runStart);&#xd;&#xa;var f_unmatched_file = latest(outDir, &#x22;Unmatched_NETC_Records_&#x22;, g_runStart);&#xd;&#xa;var files = []; if (f_matched_file != &#x22;&#x22;) { files.push(f_matched_file); } if (f_unmatched_file != &#x22;&#x22;) { files.push(f_unmatched_file); }&#xd;&#xa;var f_result_files = files.join(&#x22;,&#x22;);&#xd;&#xa;var f_success = &#x22;true&#x22;; var f_status = &#x22;Complete&#x22;; var f_message = &#x22;&#x22;;&#xd;&#xa;if (missing.length &gt; 0) { f_success = &#x22;false&#x22;; f_status = &#x22;Failure&#x22;; f_message = &#x22;NETC recon aborted - missing or empty inbound feed(s): &#x22; + missing.join(&#x22;, &#x22;); }&#xd;&#xa;else if (total == 0) { f_status = &#x22;Diverted&#x22;; f_message = &#x22;NETC recon - no clearing records found in NPCI_NETC_Mapper_Clearing.csv&#x22;; }&#xd;&#xa;else { f_message = &#x22;NETC FASTag 4-way recon &#x22; + cycle + &#x22; - &#x22; + f_total_txns + &#x22; txns / &#x22; + f_matched_txns + &#x22; matched STP / &#x22; + f_break_txns + &#x22; exceptions (&#x22; + f_double_debit_txns + &#x22; multi-antenna double debits)&#x22;; }</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Start Script</jsScript_name>
        <jsScript_script>var g_runStart = new java.util.Date().getTime() - 120000;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
