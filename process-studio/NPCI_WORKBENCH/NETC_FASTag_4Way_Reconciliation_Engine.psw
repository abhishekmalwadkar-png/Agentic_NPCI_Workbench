  <step>
    <name>MJSV_Classify_4Way</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var mapperStatus = txt(MAPPER_STATUS).toUpperCase();&#xd;&#xa;var walletStatus = txt(WALLET_DEBIT_STATUS).toUpperCase();&#xd;&#xa;var settle = txt(SETTLEMENT_STATUS).toUpperCase();&#xd;&#xa;var plazaPresent = (txt(PLAZA_ID) != &#x22;&#x22;);&#xd;&#xa;var walletPresent = (txt(WALLET_RRN) != &#x22;&#x22;);&#xd;&#xa;var glPresent = (txt(GL_RRN) != &#x22;&#x22;);&#xd;&#xa;var walletDebited = (walletStatus == &#x22;DEBITED&#x22;);&#xd;&#xa;var toll = num(TOLL_AMOUNT);&#xd;&#xa;var glAmt = num(GL_AMOUNT);&#xd;&#xa;var bal = num(WALLET_BALANCE);&#xd;&#xa;var TXN_AMOUNT = (toll != null) ? toll : ((glAmt != null) ? glAmt : 0);&#xd;&#xa;var AMOUNT_VARIANCE = (toll != null &amp;&amp; glAmt != null) ? r2(toll - glAmt) : null;&#xd;&#xa;var absVar = (AMOUNT_VARIANCE == null) ? null : Math.abs(AMOUNT_VARIANCE);&#xd;&#xa;var BREAK_CATEGORY = &#x22;&#x22;; var BREAK_REASON = &#x22;&#x22;; var EXCEPTION_SEVERITY = &#x22;NONE&#x22;;&#xd;&#xa;if (!plazaPresent &amp;&amp; walletDebited) { BREAK_CATEGORY = &#x22;WALLET_DEBIT_NO_PLAZA_CLEARANCE&#x22;; BREAK_REASON = &#x22;Wallet debited INR &#x22; + money(TXN_AMOUNT) + &#x22; but no plaza RFID read for EPC &#x22; + txt(EPC); EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (!plazaPresent) { BREAK_CATEGORY = &#x22;MISSING_PLAZA_READ&#x22;; BREAK_REASON = &#x22;Mapper txn without plaza RFID read&#x22;; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (txt(DOUBLE_READ_FLAG) == &#x22;Y&#x22; &amp;&amp; walletDebited) { BREAK_CATEGORY = &#x22;MULTI_ANTENNA_DOUBLE_DEBIT&#x22;; BREAK_REASON = txt(DOUBLE_READ_TYPE) + &#x22; re-read at &#x22; + txt(PLAZA_ID) + &#x22; lane &#x22; + txt(LANE_ID) + &#x22; &#x22; + txt(READ_GAP_SEC) + &#x22;s after lane &#x22; + txt(PREV_LANE_ID) + &#x22; - duplicate wallet debit&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (!walletPresent) { BREAK_CATEGORY = &#x22;MISSING_IN_WALLET_CBS&#x22;; BREAK_REASON = &#x22;RRN absent in FASTag wallet CBS dump&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (txt(WALLET_EPC).toUpperCase() != txt(EPC).toUpperCase()) { BREAK_CATEGORY = &#x22;EPC_MISMATCH&#x22;; BREAK_REASON = &#x22;Wallet EPC &#x22; + txt(WALLET_EPC) + &#x22; differs from mapper EPC &#x22; + txt(EPC); EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (mapperStatus == &#x22;BLACKLISTED&#x22; &amp;&amp; walletDebited) { BREAK_CATEGORY = &#x22;BLACKLISTED_TAG_PASSAGE&#x22;; BREAK_REASON = &#x22;Blacklisted tag allowed passage and debited&#x22;; EXCEPTION_SEVERITY = &#x22;CRITICAL&#x22;; }&#xd;&#xa;else if (bal != null &amp;&amp; bal &lt; 0) { BREAK_CATEGORY = &#x22;LOW_BALANCE_OVERDRAFT&#x22;; BREAK_REASON = &#x22;Wallet overdrawn to INR &#x22; + money(bal) + &#x22; after toll&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (!walletDebited) { BREAK_CATEGORY = &#x22;WALLET_DEBIT_FAILED&#x22;; BREAK_REASON = &#x22;Wallet status &#x22; + walletStatus + &#x22; while plaza cleared the vehicle&#x22;; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;else if (!glPresent) { BREAK_CATEGORY = &#x22;MISSING_IN_CONCESSIONAIRE_GL&#x22;; BREAK_REASON = &#x22;No GL-9908 concessionaire pool entry&#x22;; EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (absVar == null || absVar &gt; 0.001) { BREAK_CATEGORY = &#x22;CONCESSIONAIRE_FEE_DISPUTE&#x22;; BREAK_REASON = &#x22;Plaza toll &#x22; + money(toll) + &#x22; vs GL-9908 &#x22; + money(glAmt) + &#x22; - variance &#x22; + money(AMOUNT_VARIANCE); EXCEPTION_SEVERITY = &#x22;HIGH&#x22;; }&#xd;&#xa;else if (settle != &#x22;SETTLED&#x22;) { BREAK_CATEGORY = &#x22;SETTLEMENT_PENDING&#x22;; BREAK_REASON = &#x22;GL-9908 settlement status &#x22; + settle; EXCEPTION_SEVERITY = &#x22;LOW&#x22;; }&#xd;&#xa;else if (mapperStatus == &#x22;ACCEPTED&#x22;) { BREAK_CATEGORY = &#x22;MATCHED_STP&#x22;; BREAK_REASON = &#x22;4-way match - plaza, mapper, wallet and GL-9908 agree&#x22;; }&#xd;&#xa;else { BREAK_CATEGORY = &#x22;STATUS_MISMATCH&#x22;; BREAK_REASON = &#x22;Mapper &#x22; + mapperStatus + &#x22; / wallet &#x22; + walletStatus + &#x22; / GL &#x22; + settle; EXCEPTION_SEVERITY = &#x22;MEDIUM&#x22;; }&#xd;&#xa;var IS_MATCHED = (BREAK_CATEGORY == &#x22;MATCHED_STP&#x22;) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var MATCH_FLAG = (IS_MATCHED == &#x22;Y&#x22;) ? 1 : 0;&#xd;&#xa;var RECON_RUN_TS = nowTs(&#x22;yyyy-MM-dd HH:mm:ss&#x22;);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>TXN_AMOUNT</name><rename>TXN_AMOUNT</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>AMOUNT_VARIANCE</name><rename>AMOUNT_VARIANCE</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>BREAK_CATEGORY</name><rename>BREAK_CATEGORY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>BREAK_REASON</name><rename>BREAK_REASON</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>EXCEPTION_SEVERITY</name><rename>EXCEPTION_SEVERITY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>IS_MATCHED</name><rename>IS_MATCHED</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>MATCH_FLAG</name><rename>MATCH_FLAG</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>RECON_RUN_TS</name><rename>RECON_RUN_TS</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
