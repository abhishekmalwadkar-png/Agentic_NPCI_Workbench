  <step>
    <name>MJSV_Validate_Feeds</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var inDir = dirOf(&#x22;INPUT_DIR&#x22;);&#xd;&#xa;var f_plaza_file = inDir + &#x22;/Plaza_Lane_RFID_Trans.xml&#x22;;&#xd;&#xa;var f_mapper_file = inDir + &#x22;/NPCI_NETC_Mapper_Clearing.csv&#x22;;&#xd;&#xa;var f_wallet_file = inDir + &#x22;/FASTag_Wallet_CBS_Dump.csv&#x22;;&#xd;&#xa;var f_gl_file = inDir + &#x22;/NETC_Concessionaire_GL9908.csv&#x22;;&#xd;&#xa;var missing = [];&#xd;&#xa;if (!fileOk(f_plaza_file)) { missing.push(&#x22;Plaza_Lane_RFID_Trans.xml&#x22;); }&#xd;&#xa;if (!fileOk(f_mapper_file)) { missing.push(&#x22;NPCI_NETC_Mapper_Clearing.csv&#x22;); }&#xd;&#xa;if (!fileOk(f_wallet_file)) { missing.push(&#x22;FASTag_Wallet_CBS_Dump.csv&#x22;); }&#xd;&#xa;if (!fileOk(f_gl_file)) { missing.push(&#x22;NETC_Concessionaire_GL9908.csv&#x22;); }&#xd;&#xa;var f_feeds_ok = (missing.length == 0) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var f_missing_feeds = (missing.length == 0) ? &#x22;&#x22; : (&#x22;Missing or empty feed(s) in &#x22; + inDir + &#x22;: &#x22; + missing.join(&#x22;, &#x22;));</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>f_plaza_file</name><rename>f_plaza_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_mapper_file</name><rename>f_mapper_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_wallet_file</name><rename>f_wallet_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_gl_file</name><rename>f_gl_file</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_feeds_ok</name><rename>f_feeds_ok</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_missing_feeds</name><rename>f_missing_feeds</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
