        <jsScript_script>function txt(v) { return (v == null) ? "" : String(v).replace(/^\s+|\s+$/g, ""); }
function num(v) { var t = txt(v).replace(/,/g, ""); if (t == "") { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }
function r2(n) { return Math.round(n * 100) / 100; }
function esc(v) { return txt(v).replace(/\\/g, "\\\\").replace(/"/g, "\\\"").replace(/[\r\n\t]+/g, " "); }
function money(v) { var n = num(v); return (n == null) ? "0.00" : n.toFixed(2); }
function jnum(v) { var n = num(v); return (n == null) ? "null" : String(r2(n)); }
function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }
function sha256(s) { var md = java.security.MessageDigest.getInstance("SHA-256"); var d = md.digest(new java.lang.String(s).getBytes("UTF-8")); var h = ""; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = "0" + b; } h = h + b; } return h; }
function pv(name) { var token = "$" + "{Internal.Entry.Current.Directory}"; var base = String(getVariable("Internal.Entry.Current.Directory", "")); return txt(String(getVariable(name, "")).split(token).join(base)); }
function dirOf(name) { return pv(name).replace(/\\/g, "/").replace(/\/+$/, ""); }
function fileOk(p) { if (txt(p) == "") { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }
function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }
function enc(v) { return String(java.net.URLEncoder.encode(txt(v), "UTF-8")); }
function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf("?") &gt;= 0) ? "&amp;" : "?") + q; }
function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }

var mapperStatus = txt(MAPPER_STATUS).toUpperCase();
var walletStatus = txt(WALLET_DEBIT_STATUS).toUpperCase();
var settle = txt(SETTLEMENT_STATUS).toUpperCase();
var plazaPresent = (txt(PLAZA_ID) != "");
var walletPresent = (txt(WALLET_RRN) != "");
var glPresent = (txt(GL_RRN) != "");
var walletDebited = (walletStatus == "DEBITED");
var toll = num(TOLL_AMOUNT);
var glAmt = num(GL_AMOUNT);
var bal = num(WALLET_BALANCE);
var TXN_AMOUNT = (toll != null) ? toll : ((glAmt != null) ? glAmt : 0);
var AMOUNT_VARIANCE = (toll != null &amp;&amp; glAmt != null) ? r2(toll - glAmt) : null;
var absVar = (AMOUNT_VARIANCE == null) ? null : Math.abs(AMOUNT_VARIANCE);
var BREAK_CATEGORY = ""; var BREAK_REASON = ""; var EXCEPTION_SEVERITY = "NONE";
if (!plazaPresent &amp;&amp; walletDebited) { BREAK_CATEGORY = "WALLET_DEBIT_NO_PLAZA_CLEARANCE"; BREAK_REASON = "Wallet debited INR " + money(TXN_AMOUNT) + " but no plaza RFID read for EPC " + txt(EPC); EXCEPTION_SEVERITY = "HIGH"; }
else if (!plazaPresent) { BREAK_CATEGORY = "MISSING_PLAZA_READ"; BREAK_REASON = "Mapper txn without plaza RFID read"; EXCEPTION_SEVERITY = "MEDIUM"; }
else if (txt(DOUBLE_READ_FLAG) == "Y" &amp;&amp; walletDebited) { BREAK_CATEGORY = "MULTI_ANTENNA_DOUBLE_DEBIT"; BREAK_REASON = txt(DOUBLE_READ_TYPE) + " re-read at " + txt(PLAZA_ID) + " lane " + txt(LANE_ID) + " " + txt(READ_GAP_SEC) + "s after lane " + txt(PREV_LANE_ID) + " - duplicate wallet debit"; EXCEPTION_SEVERITY = "HIGH"; }
else if (!walletPresent) { BREAK_CATEGORY = "MISSING_IN_WALLET_CBS"; BREAK_REASON = "RRN absent in FASTag wallet CBS dump"; EXCEPTION_SEVERITY = "HIGH"; }
else if (txt(WALLET_EPC).toUpperCase() != txt(EPC).toUpperCase()) { BREAK_CATEGORY = "EPC_MISMATCH"; BREAK_REASON = "Wallet EPC " + txt(WALLET_EPC) + " differs from mapper EPC " + txt(EPC); EXCEPTION_SEVERITY = "HIGH"; }
else if (mapperStatus == "BLACKLISTED" &amp;&amp; walletDebited) { BREAK_CATEGORY = "BLACKLISTED_TAG_PASSAGE"; BREAK_REASON = "Blacklisted tag allowed passage and debited"; EXCEPTION_SEVERITY = "CRITICAL"; }
else if (bal != null &amp;&amp; bal &lt; 0) { BREAK_CATEGORY = "LOW_BALANCE_OVERDRAFT"; BREAK_REASON = "Wallet overdrawn to INR " + money(bal) + " after toll"; EXCEPTION_SEVERITY = "HIGH"; }
else if (!walletDebited) { BREAK_CATEGORY = "WALLET_DEBIT_FAILED"; BREAK_REASON = "Wallet status " + walletStatus + " while plaza cleared the vehicle"; EXCEPTION_SEVERITY = "MEDIUM"; }
else if (!glPresent) { BREAK_CATEGORY = "MISSING_IN_CONCESSIONAIRE_GL"; BREAK_REASON = "No GL-9908 concessionaire pool entry"; EXCEPTION_SEVERITY = "HIGH"; }
else if (absVar == null || absVar &gt; 0.001) { BREAK_CATEGORY = "CONCESSIONAIRE_FEE_DISPUTE"; BREAK_REASON = "Plaza toll " + money(toll) + " vs GL-9908 " + money(glAmt) + " - variance " + money(AMOUNT_VARIANCE); EXCEPTION_SEVERITY = "HIGH"; }
else if (settle != "SETTLED") { BREAK_CATEGORY = "SETTLEMENT_PENDING"; BREAK_REASON = "GL-9908 settlement status " + settle; EXCEPTION_SEVERITY = "LOW"; }
else if (mapperStatus == "ACCEPTED") { BREAK_CATEGORY = "MATCHED_STP"; BREAK_REASON = "4-way match - plaza, mapper, wallet and GL-9908 agree"; }
else { BREAK_CATEGORY = "STATUS_MISMATCH"; BREAK_REASON = "Mapper " + mapperStatus + " / wallet " + walletStatus + " / GL " + settle; EXCEPTION_SEVERITY = "MEDIUM"; }
var IS_MATCHED = (BREAK_CATEGORY == "MATCHED_STP") ? "Y" : "N";
var MATCH_FLAG = (IS_MATCHED == "Y") ? 1 : 0;
var RECON_RUN_TS = nowTs("yyyy-MM-dd HH:mm:ss");</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>TXN_AMOUNT</name><rename>TXN_AMOUNT</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>AMOUNT_VARIANCE</name><rename>AMOUNT_VARIANCE</rename><type>Number</type><length>15</length><precision>2</precision><replace>N</replace></field>
      <field><name>BREAK_CATEGORY</name><rename>BREAK_CATEGORY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>BREAK_REASON</name><rename>BREAK_REASON</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>EXCEPTION_SEVERITY</name><rename>EXCEPTION_SEVERITY</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>IS_MATCHED</name><rename>IS_MATCHED</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>MATCH_FLAG</name><rename>MATCH_FLAG</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>RECON_RUN_TS</name><rename>RECON_RUN_TS</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
