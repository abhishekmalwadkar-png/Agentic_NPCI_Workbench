x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;function first() { for (var i = 0; i &lt; arguments.length; i++) { var t = txt(arguments[i]); if (t != &#x22;&#x22;) { return t; } } return &#x22;&#x22;; }&#xd;&#xa;var REV_RRN = first(Q_RRN);&#xd;&#xa;var REV_TXN_ID = first(Q_TXN_ID);&#xd;&#xa;var REV_AMOUNT = num(Q_AMOUNT); if (REV_AMOUNT == null) { REV_AMOUNT = 0; }&#xd;&#xa;var decision = first(Q_STATUS, Q_DECISION).toUpperCase();&#xd;&#xa;var rail = first(Q_RAIL).toUpperCase();&#xd;&#xa;var cat = first(Q_CATEGORY, Q_ACTION).toUpperCase();&#xd;&#xa;var REV_EPC = first(Q_EPC);&#xd;&#xa;var REV_ACC_NO = first(Q_ACC_NO, Q_ACC_NO2);&#xd;&#xa;var REV_REF = first(Q_DOSSIER_ID, Q_ID); if (REV_REF == &#x22;&#x22;) { REV_REF = &#x22;NETC-RFD-&#x22; + REV_RRN; }&#xd;&#xa;var approved = (decision == &#x22;APPROVED&#x22; || decision == &#x22;AUTO_APPROVED&#x22; || decision == &#x22;VERIFIED&#x22;);&#xd;&#xa;var railOk = (rail == &#x22;&#x22; || rail == &#x22;NETC&#x22;);&#xd;&#xa;var isRefund = (cat == &#x22;&#x22; || cat.indexOf(&#x22;DOUBLE&#x22;) &gt;= 0 || cat.indexOf(&#x22;REFUND&#x22;) &gt;= 0 || cat.indexOf(&#x22;REVERSAL&#x22;) &gt;= 0);&#xd;&#xa;var IS_EXECUTABLE = (approved &amp;&amp; railOk &amp;&amp; isRefund &amp;&amp; REV_TXN_ID != &#x22;&#x22; &amp;&amp; REV_AMOUNT &gt; 0) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var SKIP_REASON = (IS_EXECUTABLE == &#x22;Y&#x22;) ? &#x22;&#x22; : (!railOk ? &#x22;Not a NETC item&#x22; : (!approved ? (&#x22;Decision &#x22; + decision) : (!isRefund ? (&#x22;Not a double-debit refund: &#x22; + cat) : &#x22;Missing txn_id or amount&#x22;)));&#xd;&#xa;var f_request_url = withQuery(pv(&#x22;WALLET_CORE_API_URL&#x22;), &#x22;txn_id=&#x22; + enc(REV_TXN_ID) + &#x22;&amp;approver=&#x22; + enc(&#x22;AE_NETC_WALLET_BOT&#x22;) + &#x22;&amp;notes=&#x22; + enc(&#x22;NETC double-debit refund RRN &#x22; + REV_RRN + &#x22; EPC &#x22; + REV_EPC + &#x22; INR &#x22; + REV_AMOUNT.toFixed(2)));&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var f_idempotency_key = &#x22;NETC-WR-&#x22; + REV_RRN;&#xd;&#xa;var f_payload = &#x22;{\&#x22;rail\&#x22;:\&#x22;NETC\&#x22;,\&#x22;txnType\&#x22;:\&#x22;FASTAG_WALLET_REVERSAL_CREDIT\&#x22;,\&#x22;reference\&#x22;:\&#x22;&#x22; + esc(REV_REF) + &#x22;\&#x22;,\&#x22;rrn\&#x22;:\&#x22;&#x22; + esc(REV_RRN) + &#x22;\&#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;epc\&#x22;:\&#x22;&#x22; + esc(REV_EPC) + &#x22;\&#x22;,\&#x22;accNo\&#x22;:\&#x22;&#x22; + esc(REV_ACC_NO) + &#x22;\&#x22;,\&#x22;amount\&#x22;:&#x22; + REV_AMOUNT.toFixed(2) + &#x22;,&#x22;&#xd;&#xa;  + &#x22;\&#x22;reason\&#x22;:\&#x22;MULTI_ANTENNA_DOUBLE_DEBIT_REFUND\&#x22;,\&#x22;requestedAt\&#x22;:\&#x22;&#x22; + nowTs(&#x22;yyyy-MM-dd'T'HH:mm:ss&#x22;) + &#x22;\&#x22;}&#x22;;</jsScript_script>
