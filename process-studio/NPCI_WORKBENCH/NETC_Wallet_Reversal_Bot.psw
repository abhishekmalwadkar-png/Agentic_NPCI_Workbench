<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>NETC_Wallet_Reversal_Bot</name>
    <description>NETC wallet reversal bot - pulls verified double-debit refunds and credits the FASTag wallet core, returning updated balance.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <created_user>PS Copilot</created_user>
    <created_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026&#x2f;11&#x2f;12 10&#x3a;00&#x3a;00.000</modified_date>
    <fileHash>00000000000000000000000000000000</fileHash>
    <stepEntryHash>00000000000000000000000000000000</stepEntryHash>

    <format_version>2</format_version>
    <directory>&#x2f;</directory>
    <parameters>
      <parameter>
        <name>NPCI_Queue_url</name>
        <description>Queue polled for verified NETC double-debit refund requests</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/queue</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>WALLET_CORE_API_URL</name>
        <description>Reversal execution endpoint (backend posts the wallet reversal credit) - called as ?txn_id=&amp;approver=&amp;notes=</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>http://localhost:8000/api/hitl/approve</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
      <parameter>
        <name>OUTPUT_DIR</name>
        <description>Folder for the wallet reversal audit</description>
        <param_description/>
        <type>String</type>
        <uiControlType>TextBox</uiControlType>
        <list_of_values/>
        <valueSeparator/>
        <queryName/>
        <queryMappings/>
        <default_value>D:/NPCI-Workbench/stage1/NETC_reconn/Output</default_value>
        <secret>N</secret>
        <optional>Y</optional>
        <runtime>N</runtime>
      </parameter>
    </parameters>
    <parameterConfiguration>
      <grouping>
      </grouping>
    </parameterConfiguration>
 <singleColumnLayout>Y</singleColumnLayout>
    <ps_variables>
    </ps_variables>
    <logging_table>
    </logging_table>
    <size_rowset>10000</size_rowset>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <key_for_session_key>H4sIAAAAAAAA&#x2f;wMAAAAAAAAAAAA&#x3d;</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop><from>RG_Run_Trigger</from><to>MJSV_Validate_Config</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Validate_Config</from><to>FR_Config_Valid</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Config_Valid</from><to>REST_GET_Verified_Refunds</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Config_Valid</from><to>WTL_Invalid_Config</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>WTL_Invalid_Config</from><to>MJSV_Event_Invalid</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Event_Invalid</from><to>SV_Norm_Invalid</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_GET_Verified_Refunds</from><to>MJSV_Check_Queue_Response</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_GET_Verified_Refunds</from><to>WTL_Queue_Unreachable</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>WTL_Queue_Unreachable</from><to>MJSV_Event_Queue_Down</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Event_Queue_Down</from><to>SV_Norm_Queue_Down</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Check_Queue_Response</from><to>FR_Queue_OK</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Queue_OK</from><to>JSON_Parse_Refund_Requests</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Queue_OK</from><to>WTL_Queue_Rejected</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>WTL_Queue_Rejected</from><to>MJSV_Event_Queue_Rejected</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Event_Queue_Rejected</from><to>SV_Norm_Queue_Rejected</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>JSON_Parse_Refund_Requests</from><to>MJSV_Select_Verified_Refunds</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Select_Verified_Refunds</from><to>FR_Is_Executable</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Is_Executable</from><to>REST_Wallet_Reversal_Credit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>FR_Is_Executable</from><to>WTL_Skipped_Items</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_Wallet_Reversal_Credit</from><to>MJSV_Tag_Wallet_Response</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>REST_Wallet_Reversal_Credit</from><to>WTL_Wallet_API_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>WTL_Wallet_API_Error</from><to>MJSV_Tag_Wallet_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Tag_Wallet_Response</from><to>SV_Norm_Credited</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Tag_Wallet_Error</from><to>SV_Norm_Credit_Error</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SV_Norm_Credited</from><to>XLW_Wallet_Reversal_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SV_Norm_Credit_Error</from><to>XLW_Wallet_Reversal_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SV_Norm_Invalid</from><to>XLW_Wallet_Reversal_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SV_Norm_Queue_Down</from><to>XLW_Wallet_Reversal_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>SV_Norm_Queue_Rejected</from><to>XLW_Wallet_Reversal_Audit</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>XLW_Wallet_Reversal_Audit</from><to>GB_Reversal_Totals</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>GB_Reversal_Totals</from><to>MJSV_Build_Reversal_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
    <hop><from>MJSV_Build_Reversal_Result</from><to>SWR_Reversal_Result</to><enabled>Y</enabled><visible>Y</visible></hop>
  </order>

  <step>
    <name>RG_Run_Trigger</name>
    <type>RowGenerator</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field><name>f_trigger</name><type>String</type><format/><currency/><decimal/><group/><nullif>RUN</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>64</xloc>
      <yloc>288</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>MJSV_Validate_Config</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var probs = [];&#xd;&#xa;if (!urlOk(pv(&#x22;NPCI_Queue_url&#x22;))) { probs.push(&#x22;NPCI_Queue_url invalid: '&#x22; + pv(&#x22;NPCI_Queue_url&#x22;) + &#x22;'&#x22;); }&#xd;&#xa;if (!urlOk(pv(&#x22;WALLET_CORE_API_URL&#x22;))) { probs.push(&#x22;WALLET_CORE_API_URL invalid&#x22;); }&#xd;&#xa;var f_valid = (probs.length == 0) ? &#x22;Y&#x22; : &#x22;N&#x22;;&#xd;&#xa;var f_validation_msg = probs.join(&#x22;; &#x22;);&#xd;&#xa;var f_request_url = pv(&#x22;NPCI_Queue_url&#x22;);&#xd;&#xa;var f_payload = &#x22;&#x22;;&#xd;&#xa;var f_content_type = &#x22;application/json&#x22;;&#xd;&#xa;var f_idempotency_key = &#x22;NETC-BOT-&#x22; + nowTs(&#x22;yyyyMMddHHmmss&#x22;);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>f_valid</name><rename>f_valid</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_validation_msg</name><rename>f_validation_msg</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_request_url</name><rename>f_request_url</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_payload</name><rename>f_payload</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_content_type</name><rename>f_content_type</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>f_idempotency_key</name><rename>f_idempotency_key</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>192</xloc>
      <yloc>288</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>FR_Config_Valid</name>
    <type>FilterRows</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>REST_GET_Verified_Refunds</send_true_to>
    <send_false_to>WTL_Invalid_Config</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>f_valid</leftvalue>
        <function>&#x3d;</function>
        <rightvalue/>
        <value><name>constant</name><type>String</type><text>Y</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
      </condition>
    </compare>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>320</xloc>
      <yloc>288</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>WTL_Invalid_Config</name>
    <type>WriteToLog</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_error</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>NETC wallet bot - configuration validation failed</logmessage>
    <fields>
      <field>
        <name>f_validation_msg</name>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>320</xloc>
      <yloc>640</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>MJSV_Event_Invalid</name>
    <type>ScriptValueMod</type>
    <description/>
    <customErrorMessage/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function txt(v) { return (v == null) ? &#x22;&#x22; : String(v).replace(/^\s+|\s+$/g, &#x22;&#x22;); }&#xd;&#xa;function num(v) { var t = txt(v).replace(/,/g, &#x22;&#x22;); if (t == &#x22;&#x22;) { return null; } var n = parseFloat(t); return isNaN(n) ? null : n; }&#xd;&#xa;function r2(n) { return Math.round(n * 100) / 100; }&#xd;&#xa;function esc(v) { return txt(v).replace(/\\/g, &#x22;\\\\&#x22;).replace(/&#x22;/g, &#x22;\\\&#x22;&#x22;).replace(/[\r\n\t]+/g, &#x22; &#x22;); }&#xd;&#xa;function money(v) { var n = num(v); return (n == null) ? &#x22;0.00&#x22; : n.toFixed(2); }&#xd;&#xa;function jnum(v) { var n = num(v); return (n == null) ? &#x22;null&#x22; : String(r2(n)); }&#xd;&#xa;function nowTs(p) { return String(new java.text.SimpleDateFormat(p).format(new java.util.Date())); }&#xd;&#xa;function sha256(s) { var md = java.security.MessageDigest.getInstance(&#x22;SHA-256&#x22;); var d = md.digest(new java.lang.String(s).getBytes(&#x22;UTF-8&#x22;)); var h = &#x22;&#x22;; for (var i = 0; i &lt; d.length; i++) { var b = (d[i] &amp; 0xff).toString(16); if (b.length &lt; 2) { b = &#x22;0&#x22; + b; } h = h + b; } return h; }&#xd;&#xa;function pv(name) { var token = &#x22;$&#x22; + &#x22;{Internal.Entry.Current.Directory}&#x22;; var base = String(getVariable(&#x22;Internal.Entry.Current.Directory&#x22;, &#x22;&#x22;)); return txt(String(getVariable(name, &#x22;&#x22;)).split(token).join(base)); }&#xd;&#xa;function dirOf(name) { return pv(name).replace(/\\/g, &#x22;/&#x22;).replace(/\/+$/, &#x22;&#x22;); }&#xd;&#xa;function fileOk(p) { if (txt(p) == &#x22;&#x22;) { return false; } var f = new java.io.File(txt(p)); return f.exists() &amp;&amp; f.isFile() &amp;&amp; f.length() &gt; 0; }&#xd;&#xa;function urlOk(u) { return /^https?:\/\/\S+$/i.test(txt(u)); }&#xd;&#xa;function enc(v) { return String(java.net.URLEncoder.encode(txt(v), &#x22;UTF-8&#x22;)); }&#xd;&#xa;function withQuery(base, q) { var b = txt(base); return b + ((b.indexOf(&#x22;?&#x22;) &gt;= 0) ? &#x22;&amp;&#x22; : &#x22;?&#x22;) + q; }&#xd;&#xa;function pnum(name, dflt) { var n = num(pv(name)); return (n == null) ? dflt : n; }&#xd;&#xa;&#xd;&#xa;var REV_REF = &#x22;&#x22;; var REV_TXN_ID = &#x22;&#x22;; var REV_RRN = &#x22;&#x22;; var REV_EPC = &#x22;&#x22;; var REV_ACC_NO = &#x22;&#x22;; var REV_AMOUNT = 0;&#xd;&#xa;var WALLET_HTTP = &#x22;N/A&#x22;; var REVERSAL_STATUS = &#x22;INVALID_CONFIG&#x22;; var UPDATED_BALANCE = null;&#xd;&#xa;var N_CREDITED = 0; var N_FAILED = 0; var N_QUEUE_FAILED = 0; var N_INVALID = 1; var CREDITED_AMOUNT = 0;&#xd;&#xa;var EVENT_DETAIL = String(f_validation_msg);&#xd;&#xa;var AUDIT_TS = nowTs(&#x22;yyyy-MM-dd HH:mm:ss&#x22;);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>REV_REF</name><rename>REV_REF</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
